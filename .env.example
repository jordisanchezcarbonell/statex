# Variables de entorno de la web. Copia este archivo a .env.local para desarrollo y rellena los valores.
# Nunca subas .env.local al repositorio. En Vercel: Project Settings → Environment Variables.
# Todas se leen al construir: tras cambiarlas en Vercel hay que volver a desplegar.

# ── Dominio ─────────────────────────────────────────────
# URL pública (canonicals, sitemap, Open Graph). Sin coste (2026-10-31): subdominio de jordisanchezweb.es.
# Si se registra statexsecurity.com más adelante, basta con cambiar esta variable y volver a desplegar.
NEXT_PUBLIC_SITE_URL=https://statex.jordisanchezweb.es
# Indexación en buscadores. Solo "true" con aprobación expresa de los fundadores.
SITE_INDEXABLE=false

# ── Formulario de contacto (Resend, https://resend.com) ─
# Clave de API de Resend (permiso "Sending access" basta)
RESEND_API_KEY=
# Buzón que recibe las solicitudes (no se muestra en la web; puede ser un correo personal)
CONTACT_TO=
# Remitente verificado en Resend (dominio statex.jordisanchezweb.es verificado)
CONTACT_FROM=StateX <formulario@statex.jordisanchezweb.es>
# Clave para firmar el token de tiempo del formulario (HMAC-SHA256). Opcional: si falta se usa
# RESEND_API_KEY. Definir una dedicada permite rotarla sin tocar el envío de correo.
CONTACT_TOKEN_SECRET=

# ── Previews de identidad (/preview/statex, /preview/noxen, /preview/vantis) ─
# Opcional. Con ambas definidas, las previews piden usuario y contraseña; sin ellas son públicas (noindex).
# Se leen en cada petición (proxy.ts), no al construir: no hace falta volver a desplegar al cambiarlas.
PREVIEW_USER=
PREVIEW_PASSWORD=
