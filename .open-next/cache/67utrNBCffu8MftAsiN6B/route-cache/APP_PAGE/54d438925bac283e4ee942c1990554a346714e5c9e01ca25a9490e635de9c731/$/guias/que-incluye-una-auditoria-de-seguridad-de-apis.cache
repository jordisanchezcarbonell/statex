{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/guias/layout,_N_T_/guias/[slug]/layout,_N_T_/guias/[slug]/page,_N_T_/guias/que-incluye-una-auditoria-de-seguridad-de-apis"},"segmentPaths":["/_tree","/_full","/guias/$d$slug/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}}},"routeCache":{"key":"/route-cache/APP_PAGE/54d438925bac283e4ee942c1990554a346714e5c9e01ca25a9490e635de9c731/$/guias/que-incluye-una-auditoria-de-seguridad-de-apis","owner":{"kind":"APP_PAGE","sourceRoute":"/guias/[slug]/page"},"isFallback":false}},"html":"<!DOCTYPE html><html lang=\"es\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/234d9015b631dab9-s.p.33gca1im1ku45.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/c88e89b5552bf96c-s.p.15c5kk-3im2ev.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1fqe_13ohcig3.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/1s-6hrumt1sva.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/1x6obpmlu1_c2.js\"/><script src=\"/_next/static/chunks/2r4s4h5xul1n-.js\" async=\"\"></script><script src=\"/_next/static/chunks/2khxl0v1q4i6n.js\" async=\"\"></script><script src=\"/_next/static/chunks/3-df9nqfnonu3.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2c3mg3r-05n1w.js\" async=\"\"></script><script src=\"/_next/static/chunks/42onvq6nokjl2.js\" async=\"\"></script><script src=\"/_next/static/chunks/10o7_ta9syrsn.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#0B0D10\"/><meta name=\"color-scheme\" content=\"dark\"/><title>Qué incluye una auditoría de seguridad de APIs · StateX</title><meta name=\"description\" content=\"El OWASP API Security Top 10 explicado en llano, qué cambia en REST, GraphQL y webhooks, qué preparar, qué entregables pedir y ejemplos de precio.\"/><meta name=\"application-name\" content=\"StateX\"/><meta name=\"robots\" content=\"noindex, nofollow\"/><link rel=\"canonical\" href=\"https://statex.jordigw.workers.dev/guias/que-incluye-una-auditoria-de-seguridad-de-apis\"/><meta name=\"format-detection\" content=\"telephone=no, address=no, email=no\"/><meta property=\"og:title\" content=\"Qué incluye una auditoría de seguridad de APIs\"/><meta property=\"og:description\" content=\"El OWASP API Security Top 10 explicado en llano, qué cambia en REST, GraphQL y webhooks, qué preparar, qué entregables pedir y ejemplos de precio.\"/><meta property=\"og:url\" content=\"https://statex.jordigw.workers.dev/guias/que-incluye-una-auditoria-de-seguridad-de-apis\"/><meta property=\"og:site_name\" content=\"StateX\"/><meta property=\"og:locale\" content=\"es_ES\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"2026-10-25\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Qué incluye una auditoría de seguridad de APIs\"/><meta name=\"twitter:description\" content=\"El OWASP API Security Top 10 explicado en llano, qué cambia en REST, GraphQL y webhooks, qué preparar, qué entregables pedir y ejemplos de precio.\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div style=\"--h-ink:#0B0D10;--h-graphite:#20242A;--h-ivory:#F2F0EA;--h-titanium:#A8A39B;--h-red:#A83A35;--h-red-text:#E07A73;--h-line:rgba(242,240,234,0.14);--h-stone:#5C5850;--h-paper-line:rgba(11,13,16,0.14);--h-display:var(--h-sans);--h-display-weight:600;--h-title-weight:600;--h-display-case:uppercase