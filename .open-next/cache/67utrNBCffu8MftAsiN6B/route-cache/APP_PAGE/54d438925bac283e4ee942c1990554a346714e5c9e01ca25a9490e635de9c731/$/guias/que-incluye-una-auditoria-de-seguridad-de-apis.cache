ition\":2,\"name\":\"Qué incluye una auditoría de seguridad de APIs\",\"item\":\"https://statex.jordigw.workers.dev/guias/que-incluye-una-auditoria-de-seguridad-de-apis\"}]}]9:[\"$\",\"div\",null,{\"style\":{\"--h-ink\":\"#0B0D10\",\"--h-graphite\":\"#20242A\",\"--h-ivory\":\"#F2F0EA\",\"--h-titanium\":\"#A8A39B\",\"--h-red\":\"#A83A35\",\"--h-red-text\":\"#E07A73\",\"--h-line\":\"rgba(242,240,234,0.14)\",\"--h-stone\":\"#5C5850\",\"--h-paper-line\":\"rgba(11,13,16,0.14)\",\"--h-display\":\"var(--h-sans)\",\"--h-display-weight\":\"600\",\"--h-title-weight\":\"600\",\"--h-display-case\":\"uppercase\",\"--h-display-tracking\":\"-0.025em\"},\"className\":\"_17R3Ca_variable min-h-dvh overflow-x-clip bg-(--h-ink) font-(family-name:--h-sans) text-(--h-ivory) antialiased selection:bg-(--h-red) selection:text-(--h-ivory)\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#contenido\",\"className\":\"sr-only z-[60] bg-(--h-ivory) px-4 py-3 text-(--h-ink) focus:not-sr-only focus:fixed focus:left-4 focus:top-4\",\"children\":\"Saltar al contenido\"}],[\"$\",\"$L15\",null,{\"base\":\"/\",\"items\":[{\"href\":\"#servicios\",\"label\":\"Servicios\"},{\"href\":\"#metodo\",\"label\":\"Método\"},{\"href\":\"#por-que\",\"label\":\"Por qué\"},{\"href\":\"#entregables\",\"label\":\"Entregables\"},{\"href\":\"#equipo\",\"label\":\"Equipo\"}],\"brand\":\"$undefined\"}],[\"$\",\"main\",null,{\"id\":\"contenido\",\"children\":[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$16\"}}],[\"$\",\"article\",null,{\"aria-labelledby\":\"h-guia\",\"className\":\"pb-[clamp(5rem,10vw,8rem)] pt-36 sm:pt-44\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Ruta de navegación\",\"children\":[\"$\",\"ol\",null,{\"className\":\"m-0 flex list-none flex-wrap gap-x-2 p-0 text-[14px] text-(--h-titanium)\",\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"$L17\",null,{\"href\":\"/\",\"className\":\"hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\",\"children\":\"Inicio\"}],\" /\"]}],[\"$\",\"li\",null,{\"aria-current\":\"page\",\"className\":\"text-(--h-ivory)/85\",\"children\":\"Qué incluye una auditoría de APIs\"}]]}]}],[\"$\",\"h1\",null,{\"id\":\"h-guia\",\"className\":\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:'opsz'_32] text-balance m-0 mt-10 max-w-[22ch] text-[clamp(2rem,4.8vw,4rem)]\",\"children\":\"Qué incluye una auditoría de seguridad de APIs\"}],[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"className\":\"mt-10 block h-0.5 w-24 bg-(--h-red)\"}],[\"$\",\"p\",null,{\"className\":\"m-0 mt-8 text-[14px] text-(--h-titanium)\",\"children\":[\"Por \",\"[retirado] y Jordi Sánchez\",\" · \",[\"$\",\"time\",null,{\"dateTime\":\"2026-10-25\",\"children\":\"25 de octubre de 2026\"}]]}],[\"$\",\"div\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"max-w-[68ch] text-[17px] leading-[1.7] text-(--h-ivory)/85 [&_h2]:mt-16 [&_h2]:mb-5 [&_h2]:text-[clamp(1.35rem,2.2vw,1.75rem)] [&_h2]:font-semibold [&_h2]:uppercase [&_h2]:leading-[1.1] [&_h2]:tracking-[-0.015em] [&_h2]:text-(--h-ivory) [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:text-[1.1rem] [&_h3]:font-semibold [&_h3]:text-(--h-ivory) [&_p]:my-4 [&_ul]:my-4 [&_ul]:pl-5 [&_ul]:list-disc [&_ol]:my-4 [&_ol]:pl-5 [&_ol]:list-decimal [&_li]:my-2 [&_strong]:text-(--h-ivory) [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-(--h-ivory)\",\"children\":[\"$L18\",\"$L19\",\"$L1a\"]}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\"]}],\"$L1f\"]}]}]]}],\"$L20\",\"$undefined\"]}]\n18:[\"$\",\"p\",null,{\"className\":\"text-[clamp(1.1rem,1.5vw,1.25rem)] leading-[1.6] text-(--h-ivory)\",\"children\":\"En una aplicación moderna, la interfaz es solo una capa: casi todo lo importante pasa por la API. Por eso muchos de los fallos más graves no se ven en la web, pero se explotan con una simple petición. Esta guía explica qué revisa una auditoría de seguridad de APIs, qué tienes que preparar y de qué depende el precio.\"}]\n19:[\"$\",\"section\",null,{\"aria-labelledby\":\"g-api-diferencia\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"g-api-diferencia\",\"children\":\"Por qué una API necesita su propia auditoría\"}],[[\"$\",\"p\",null,{\"children\":\"Una auditoría web revisa la aplicación a través de la interfaz. Pero un atacante no usa tu interfaz: llama a la API directamente, con los parámetros que quiere y en el orden que quiere. Lo que la interfaz oculta, como un botón de administración o un campo que no se puede editar, la API puede seguir aceptándolo.\"}],[\"$\",\"p\",null,{\"children\":\"Además, las APIs suelen tener consumidores que no ves: aplicaciones móviles, integraciones de clientes, webhooks o versiones antiguas que nadie apagó. Todo eso forma parte de la superficie de ataque.\"}]]]}]\n1a:[\"$\",\"section\",null,{\"aria-labelledby\":\"g-api-top10\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"g-api-top10\",\"children\":\"Qué revisa: el OWASP API Security Top 10\"}],[\"$\",\"p\",null,{\"children\":\"El marco de referencia es el OWASP API Security Top 10, la lista pública de los riesgos más habituales en APIs (edición de 2023). Una auditoría seria los cubre todos dentro del alcance acordado:\"}]]}]\n1b:[\"$\",\"ol\",null,{\"className\":\"m-0 mt-6 grid max-w-[68rem] list-none gap-px bg-(--h-line) p-0 md:grid-cols-2\",\"children\":[[\"$\",\"li\",\"API1\",{\"className\":\"bg-(--h-ink) py-5 md:pr-8 md:odd:pr-10 md:even:pl-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"m-0 font-semibold\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-3 font-normal tabular-nums text-(--h-titanium)\",\"children\":\"API1\"}],\"Autorización rota a nivel de objeto (BOLA)\"]}],[\"$\",\"p\",null,{\"className\":\"m-0 mt-2 text-[15px] leading-[1.6] text-(--h-titanium)\",\"children\":\"Cambiar un identificador en la URL o en el cuerpo de la petición permite leer o modificar recursos de otro usuario. Encabeza la lista de OWASP y suele ser de los más graves.\"}]]}],[\"$\",\"li\",\"API2\",{\"className\":\"bg-(--h-ink) py-5 md:pr-8 md:odd:pr-10 md:even:pl-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"m-0 font-semibold\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-3 font-normal tabular-nums text-(--h-titanium)\",\"children\":\"API2\"}],\"Autenticación rota\"]}],[\"$\",\"p\",null,{\"className\":\"m-0 mt-2 text-[15px] leading-[1.6] text-(--h-titanium)\",\"children\":\"Tokens que no caducan, recuperación de contraseña débil, ausencia de límite de intentos o claves de API que se aceptan sin validar.\"}]]}],[\"$\",\"li\",\"API3\",{\"className\":\"bg-(--h-ink) py-5 md:pr-8 md:odd:pr-10 md:even:pl-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"m-0 font-semibold\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-3 font-normal tabular-nums text-(--h-titanium)\",\"children\":\"API3\"}],\"Autorización rota a nivel de propiedad\"]}],[\"$\",\"p\",null,{\"className\":\"m-0 mt-2 text-[15px] leading-[1.6] text-(--h-titanium)\",\"children\":\"La API devuelve campos que el usuario no debería ver o acepta campos que no debería poder cambiar, como un rol o un precio.\"}]]}],[\"$\",\"li\",\"API4\",{\"className\":\"bg-(--h-ink) py-5 md:pr-8 md:odd:pr-10 md:even:pl-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"m-0 font-semibold\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-3 font-normal tabular-nums text-(--h-titanium)\",\"children\":\"API4\"}],\"Consumo de recursos sin límite\"]}],[\"$\",\"p\",null,{\"className\":\"m-0 mt-2 text-[15px] leading-[1.6] text-(--h-titanium)\",\"children\":\"Sin límites de peticiones, de tamaño o de paginación, cualquiera puede encarecer tu factura o degradar el servicio.\"}]]}],[\"$\",\"li\",\"API5\",{\"className\":\"bg-(--h-ink) py-5 md:pr-8 md:odd:pr-10 md:even:pl-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"m-0 font-semibold\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-3 font-normal tabular-nums text-(--h-titanium)\",\"children\":\"API5\"}],\"Autorización rota a nivel de función\"]}],[\"$\",\"p\",null,{\"className\":\"m-0 mt-2 text-[15px] leading-[1.6] text-(--h-titanium)\",\"children\":\"Un usuario normal puede llamar a funciones de administración porque el control solo existe en la interfaz.\"}]]}],[\"$\",\"li\",\"API6\",{\"className\":\"bg-(--h-ink) py-5 md:pr-8 md:odd:pr-10 md:even:pl-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"m-0 font-semibold\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-3 font-normal tabular-nums text-(--h-titanium)\",\"children\":\"API6\"}],\"Acceso sin control a flujos sensibles del negocio\"]}],[\"$\",\"p\",null,{\"className\":\"m-0 mt-2 text-[15px] leading-[1.6] text-(--h-titanium)\",\"children\":\"Flujos legítimos que se pueden automatizar de forma abusiva: compras masivas, creación de cuentas, envío de mensajes.\"}]]}],[\"$\",\"li\",\"API7\",{\"className\":\"bg-(--h-ink) py-5 md:pr-8 md:odd:pr-10 md:even:pl-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"m-0 font-semibold\",\"children\":[[\"$\",\"span\",null,{\"className\":\"mr-3 font-normal tabular-nums text-(--h-titanium)\",\"children\":\"API7\"}],\"Falsificación de peticiones desde el servidor (SSRF)\"]}],[\"$\",\"p\",null,{\"className\":\"m-0 mt-2 text-[15px] leading-[1.6] text-(--h-titanium)\",\"children\":\"La API descarga una URL que le pasa el usuario y se la puede dirigir a servicios internos o a los metadatos del proveedor cloud.\"}]]}],[\"$\",\"li\",\"API8\",{\"className\":\"bg-(--h-ink) py-5 md:pr-8 md:odd:pr-10 md:even:pl-8\",\"children\":[\"$L21\",\"$L22\"]}],\"$L23\",\"$L24\"]}]\n1c:[\"$\",\"div\",null,{\"className\":\"mt-4 max-w-[68ch] text-[17px] leading-[1.7] text-(--h-ivory)/85 [&_h2]:mt-16 [&_h2]:mb-5 [&_h2]:text-[clamp(1.35rem,2.2vw,1.75rem)] [&_h2]:font-semibold [&_h2]:uppercase [&_h2]:leading-[1.1] [&_h2]:tracking-[-0.015em] [&_h2]:text-(--h-ivory) [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:text-[1.1rem] [&_h3]:font-semibold [&_h3]:text-(--h-ivory) [&_p]:my-4 [&_ul]:my-4 [&_ul]:pl-5 [&_ul]:list-disc [&_ol]:my-4 [&_ol]:pl-5 [&_ol]:list-decimal [&_li]:my-2 [&_strong]:text-(--h-ivory) [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-(--h-ivory)\",\"children\":[[\"$\",\"section\",null,{\"aria-labelledby\":\"g-api-graphql\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"g-api-graphql\",\"children\":\"REST, GraphQL y webhooks\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"REST:\"}],\" se prueba cada endpoint con cada rol, cambiando identificadores, métodos y campos para comprobar que el servidor, y no la interfaz, decide qué está permitido.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"GraphQL:\"}],\" además de lo anterior, se revisa si el esquema se expone sin necesidad (introspección), si se pueden pedir consultas muy profundas o agrupadas que saturen el servidor, y si los permisos se aplican en cada campo y no solo en la consulta principal.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Webhooks:\"}],\" que se verifique la firma de cada mensaje, que no se puedan reenviar mensajes antiguos y que una URL de destino no sirva para atacar servicios internos.\"]}]]}]]}],[\"$\",\"section\",null,{\"aria-labelledby\":\"g-api-preparar\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"g-api-preparar\",\"children\":\"Qué tienes que preparar\"}],[[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"La especificación de la API\"}],\", si la tienes: un fichero OpenAPI (Swagger), una colección de Postman o el esquema de GraphQL. Si no existe, se puede trabajar a partir del tráfico de la aplicación, pero lleva más tiempo.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Credenciales de prueba para cada rol\"}],\" y, si hay varias empresas cliente, al menos dos cuentas de empresas distintas para probar que no se ven entre ellas.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Un entorno de preproducción\"}],\" con datos ficticios, sobre todo si la API tiene operaciones que crean, borran o cobran.\"]}],[\"$\",\"li\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Los límites conocidos:\"}],\" qué endpoints no se deben tocar, qué integraciones con terceros hay que simular y en qué horario se puede probar.\"]}]]}],[\"$\",\"p\",null,{\"children\":[\"Tienes la lista completa en \",[\"$\",\"$L17\",null,{\"href\":\"/guias/como-preparar-tu-web-para-una-auditoria-de-seguridad\",\"className\":\"focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\",\"children\":\"cómo preparar tu web para una auditoría\"}],\".\"]}]]]}],[\"$\",\"section\",null,{\"aria-labelledby\":\"g-api-entregables\",\"children\":[[\"$\",\"h2\",null,{\"id\":\"g-api-entregables\",\"children\":\"Qué deberías recibir\"}],[[\"$\",\"p\",null,{\"children\":\"Lo mismo que en cualquier auditoría (resumen ejecutivo, hallazgos con severidad, evidencias reproducibles, impacto y recomendaciones) y, en el caso de una API, además:\"}],[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":[\"La \",[\"$\",\"strong\",null,{\"children\":\"petición y la respuesta exactas\"}],\" de cada hallazgo, listas para que tu equipo las repita.\"]}],[\"$\",\"li\",null,{\"children\":[\"Una \",[\"$\",\"strong\",null,{\"children\":\"matriz de permisos\"}],\": qué rol pudo hacer qué en cada endpoint probado, para que veáis de un vistazo dónde falla el control de acceso.\"]}],[\"$\",\"li\",null,{\"children\":[\"La \",[\"$\",\"strong\",null,{\"children\":\"corrección en el punto exacto\"}],\": en qué capa (controlador, middleware, consulta) conviene aplicar la comprobación para que no vuelva a pasar en otros endpoints.\"]}]]}]]]}],\"$L25\"]}]\n1d:[\"$\",\"div\",null,{\"className\":\"mt-6 max-w-[68rem] overflow-x-auto\",\"role\":\"region\",\"aria-label\":\"Ejemplos de alcance y precio de auditoría de APIs\",\"tabIndex\":0,\"children\":[\"$\",\"table\",null,{\"className\":\"w-full min-w-[40rem] border-collapse text-left text-[15px]\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"text-[13px] text-(--h-titanium)\",\"children\":[[\"$\",\"th\",null,{\"scope\":\"col\",\"className\":\"py-3 pr-6 font-normal\",\"children\":\"Caso\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"className\":\"py-3 pr-6 font-normal\",\"children\":\"Alcance\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"className\":\"py-3 pr-6 font-normal\",\"children\":\"Trabajo\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"className\":\"py-3 font-normal\",\"children\":\"Precio StateX\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"API pequeña\",{\"className\":\"border-t border-(--h-line)\",\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"className\":\"py-4 pr-6 align-top font-semibold\",\"children\":\"API pequeña\"}],[\"$\",\"td\",null,{\"className\":\"py-4 pr-6 align-top leading-[1.5] text-(--h-titanium)\",\"children\":\"Hasta 15 endpoints, un tipo de usuario, REST\"}],[\"$\",\"td\",null,{\"className\":\"py-4 pr-6 align-top tabular-nums\",\"children\":\"1–1,5 días\"}],[\"$\",\"td\",null,{\"className\":\"py-4 align-top font-medium tabular-nums\",\"children\":\"desde 690 €\"}]]}],[\"$\",\"tr\",\"API de producto\",{\"className\":\"border-t border-(--h-line)\",\"children\":[[\"$\",\"th\",null,{\"scope\":\"row\",\"className\":\"py-4 pr-6 align-top font-semibold\",\"children\":\"API de producto\"}],[\"$\",\"td\",null,{\"className\":\"py-4 pr-6 align-top leading-[1.5] text-(--h-titanium)\",\"children\":\"30–40 endpoints, 2–3 roles, REST con OAuth o JWT\"}],[\"$\",\"td\",null,{\"className\":\"py-4 pr-6 align-top tabular-nums\",\"children\":\"2,5–3,5 días\"}],[\"$\