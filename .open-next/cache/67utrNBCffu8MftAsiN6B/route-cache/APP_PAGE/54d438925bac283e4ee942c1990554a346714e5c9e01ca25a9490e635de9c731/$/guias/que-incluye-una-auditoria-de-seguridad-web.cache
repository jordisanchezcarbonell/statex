]}]}]]}],\\\"$L1a\\\",\\\"$undefined\\\"]}]\\n18:[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-12\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-[68ch] text-[17px] leading-[1.7] text-(--h-ivory)/85 [\\u0026_h2]:mt-16 [\\u0026_h2]:mb-5 [\\u0026_h2]:text-[clamp(1.35rem,2.2vw,1.75rem)] [\\u0026_h2]:font-semibold [\\u0026_h2]:uppercase [\\u0026_h2]:leading-[1.1] [\\u0026_h2]:tracking-[-0.015em] [\\u0026_h2]:text-(--h-ivory) [\\u0026_h3]:mt-8 [\\u0026_h3]:mb-2 [\\u0026_h3]:text-[1.1rem] [\\u0026_h3]:font-semibold [\\u0026_h3]:text-(--h-ivory) [\\u0026_p]:my-4 [\\u0026_ul]:my-4 [\\u0026_ul]:pl-5 [\\u0026_ul]:list-disc [\\u0026_ol]:my-4 [\\u0026_ol]:pl-5 [\\u0026_ol]:list-decimal [\\u0026_li]:my-2 [\\u0026_strong]:text-(--h-ivory) [\\u0026_a]:underline [\\u0026_a]:underline-offset-4 [\\u0026_a:hover]:text-(--h-ivory)\\\",\\\"children\\\":[[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"text-[clamp(1.1rem,1.5vw,1.25rem)] leading-[1.6] text-(--h-ivory)\\\",\\\"children\\\":\\\"Si estás pidiendo presupuestos para auditar la seguridad de tu web, verás precios que van de unos cientos a varios miles de euros por lo que parece el mismo servicio. No lo es. Esta guía explica qué debería incluir una auditoría, qué tienes que recibir al final y qué factores hacen que cueste más o menos.\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"aria-labelledby\\\":\\\"g-que-es\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"g-que-es\\\",\\\"children\\\":\\\"Qué es (y qué no es) una auditoría de seguridad web\\\"}],[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Una auditoría de seguridad web, también llamada pentest web o prueba de penetración, es una revisión en la que alguien intenta, con tu permiso, hacer con tu aplicación lo que no debería poder hacerse: ver datos de otro usuario, saltarse un pago, convertirse en administrador o acceder a lo que no está publicado.\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"No es un escáner automático.\\\"}],\\\" Los escáneres son útiles para encontrar versiones antiguas o configuraciones conocidas, pero generan falsos positivos y no entienden tu negocio. No saben, por ejemplo, que un usuario de la empresa A no debería ver las facturas de la empresa B. Esos fallos de autorización y de lógica de negocio son de los más graves y solo los encuentra una persona.\\\"]}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"Una auditoría seria combina herramientas con pruebas manuales y \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"verifica cada hallazgo\\\"}],\\\" antes de incluirlo en el informe.\\\"]}]]]}],[\\\"$\\\",\\\"section\\\",null,{\\\"aria-labelledby\\\":\\\"g-incluye\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"g-incluye\\\",\\\"children\\\":\\\"Qué revisa\\\"}],[[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"El marco de referencia más usado es la guía de pruebas de OWASP (OWASP WSTG) y, para APIs, el OWASP API Security Top 10 (lo explicamos en \\\",[\\\"$\\\",\\\"$L17\\\",null,{\\\"href\\\":\\\"/guias/que-incluye-una-auditoria-de-seguridad-de-apis\\\",\\\"className\\\":\\\"focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\\\",\\\"children\\\":\\\"la guía de auditoría de APIs\\\"}],\\\"). En la práctica, una auditoría de una web con zona privada revisa como mínimo:\\\"]}],[\\\"$\\\",\\\"ul\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Autenticación:\\\"}],\\\" registro, inicio de sesión, recuperación de contraseña, sesiones, doble factor.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Autorización:\\\"}],\\\" que cada usuario solo vea y modifique lo suyo, y que un rol básico no pueda hacer cosas de administrador.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Exposición de datos:\\\"}],\\\" información de más en respuestas, errores, ficheros o copias de seguridad accesibles.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Validación de entradas:\\\"}],\\\" inyecciones (SQL, comandos, plantillas), XSS y subida de ficheros.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Lógica de negocio:\\\"}],\\\" precios, cupones, límites, flujos que se pueden saltar o repetir.\\\"]}],[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[\\\"$L1b\\\",\\\" cabeceras de seguridad, TLS, CORS, cookies, paneles y entornos de pruebas expuestos.\\\"]}],\\\"$L1c\\\"]}],\\\"$L1d\\\",\\\"$L1e\\\"]]}],\\\"$L1f\\\",\\\"$L20\\\"]}],\\\"$L21\\\",\\\"$L22\\\"]}]\\n19:[\\\"$\\\",\\\"aside\\\",null,{\\\"aria-labelledby\\\":\\\"h-guia-cta\\\",\\\"className\\\":\\\"mt-20 grid gap-6 bg-(--h-graphite) p-7 sm:p-10 lg:grid-cols-12 lg:items-center lg:gap-10\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"lg:col-span-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"id\\\":\\\"h-guia-cta\\\",\\\"className\\\":\\\"m-0 text-[1.35rem] font-semibold\\\",\\\"children\\\":\\\"¿Quieres saber cuánto costaría la tuya?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"m-0 mt-3 max-w-[60ch] leading-[1.6] text-(--h-titanium)\\\",\\\"children\\\":[\\\"Cuéntanos qué aplicación quieres revisar y te enviamos una propuesta cerrada en 48 horas laborables. También puedes ver el detalle de la \\\",[\\\"$\\\",\\\"$L17\\\",null,{\\\"href\\\":\\\"/servicios/auditoria-seguridad-web-api\\\",\\\"className\\\":\\\"underline underline-offset-4 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\\\",\\\"children\\\":\\\"auditoría de seguridad web y APIs\\\"}],\\\".\\\"]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"lg:col-span-4 lg:justify-self-end\\\",\\\"c