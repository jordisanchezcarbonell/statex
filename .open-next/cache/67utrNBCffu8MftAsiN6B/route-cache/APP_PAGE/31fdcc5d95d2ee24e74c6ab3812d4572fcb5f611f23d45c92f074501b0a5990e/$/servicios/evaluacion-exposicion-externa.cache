 type=\"button\" aria-expanded=\"false\" aria-controls=\"_R_inpfivb_\" class=\"inline-flex size-11 shrink-0 cursor-pointer items-center justify-center lg:hidden focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg><span class=\"sr-only\">Abrir menú</span></button></div></div><div id=\"_R_inpfivb_\" hidden=\"\" class=\"fixed inset-x-0 bottom-0 top-18 overflow-y-auto bg-(--h-ink) sm:top-20 lg:hidden\"><nav aria-label=\"Principal (móvil)\" class=\"px-4 pb-28 pt-6 sm:px-8\"><ul class=\"m-0 list-none p-0\"><li class=\"border-b border-(--h-line)\"><a href=\"/#servicios\" class=\"flex min-h-16 items-center text-[1.6rem] tracking-[-0.02em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">Servicios</a></li><li class=\"border-b border-(--h-line)\"><a href=\"/#metodo\" class=\"flex min-h-16 items-center text-[1.6rem] tracking-[-0.02em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">Método</a></li><li class=\"border-b border-(--h-line)\"><a href=\"/#por-que\" class=\"flex min-h-16 items-center text-[1.6rem] tracking-[-0.02em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">Por qué</a></li><li class=\"border-b border-(--h-line)\"><a href=\"/#entregables\" class=\"flex min-h-16 items-center text-[1.6rem] tracking-[-0.02em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">Entregables</a></li><li class=\"border-b border-(--h-line)\"><a href=\"/#equipo\" class=\"flex min-h-16 items-center text-[1.6rem] tracking-[-0.02em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">Equipo</a></li></ul><a href=\"/#contacto\" class=\"mt-10 inline-flex min-h-13 items-center bg-(--h-ivory) px-6 font-medium text-(--h-ink) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">Solicitar evaluación</a></nav></div></header><main id=\"contenido\"><script type=\"application/ld+json\">[{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Evaluación de exposición externa\",\"description\":\"Evaluación de la exposición externa de tu empresa: inventario de activos, servicios expuestos, configuraciones débiles y software desactualizado, priorizados por criticidad.\",\"url\":\"https://statex.jordigw.workers.dev/servicios/evaluacion-exposicion-externa\",\"serviceType\":\"Evaluación de exposición externa\",\"areaServed\":{\"@type\":\"Country\",\"name\":\"España\"},\"provider\":{\"@type\":\"ProfessionalService\",\"name\":\"StateX\",\"url\":\"https://statex.jordigw.workers.dev\"}},{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Inicio\",\"item\":\"https://statex.jordigw.workers.dev\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Servicios\",\"item\":\"https://statex.jordigw.workers.dev/#servicios\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Evaluación de exposición externa\",\"item\":\"https://statex.jordigw.workers.dev/servicios/evaluacion-exposicion-externa\"}]}]</script><section aria-labelledby=\"h-servicio\" class=\"pb-[clamp(4rem,8vw,7rem)] pt-36 sm:pt-44\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><nav aria-label=\"Ruta de navegación\"><ol class=\"m-0 flex list-none flex-wrap gap-x-2 p-0 text-[14px] text-(--h-titanium)\"><li><a class=\"hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/\">Inicio</a> /</li><li><a class=\"hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/#servicios\">Servicios</a> /</li><li aria-current=\"page\" class=\"text-(--h-ivory)/85\">Evaluación de exposición externa</li></ol></nav><h1 id=\"h-servicio\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 mt-10 max-w-[18ch] text-[clamp(2.2rem,5.6vw,5rem)]\">Evaluación de exposición externa</h1><span aria-hidden=\"true\" class=\"mt-10 block h-0.5 w-24 bg-(--h-red)\"></span><div class=\"mt-10 grid gap-10 lg:grid-cols-12 lg:items-end\"><p class=\"m-0 max-w-[50ch] text-[clamp(1.1rem,1.6vw,1.35rem)] leading-[1.55] text-(--h-ivory)/85 lg:col-span-7\">Descubrimos qué ve un atacante de tu empresa en internet y qué parte de eso supone un riesgo real.</p><div class=\"lg:col-span-5 lg:justify-self-end\"><a href=\"#contacto\" class=\"inline-flex min-h-12 items-center font-medium transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) bg-(--h-ivory) px-7 text-(--h-ink) hover:bg-white\">Solicitar evaluación</a></div></div><p class=\"m-0 mt-8 text-[1.1rem] tabular-nums\">Desde 390 € + IVA</p><p class=\"m-0 mt-2 max-w-[70ch] text-[14px] leading-[1.55] text-(--h-titanium)\">El precio desde corresponde a un dominio con sus subdominios. Cada dominio adicional o rango de IP se presupuesta aparte.</p><p class=\"m-0 mt-2 text-[14px] text-(--h-titanium)\">Referencia: <!-- -->Buenas prácticas OWASP y CIS para servicios expuestos</p></div></section><section aria-label=\"Detalle del servicio\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)] border-t border-(--h-line)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14 grid gap-12 md:grid-cols-2 lg:grid-cols-3 lg:gap-10\"><div class=\"border-t border-(--h-line) pt-7\"><h2 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Para quién</h2><ul class=\"m-0 mt-5 grid list-none gap-3 p-0\"><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Empresas con infraestructura pública o muchos dominios</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Organizaciones que han crecido rápido o por adquisiciones</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Equipos sin un inventario fiable de lo que publican</li></ul></div><div class=\"border-t border-(--h-line) pt-7\"><h2 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Qué revisamos</h2><ul class=\"m-0 mt-5 grid list-none gap-3 p-0\"><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Activos y subdominios desconocidos u olvidados</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Servicios expuestos sin necesidad</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Configuraciones débiles en dominios, correo y TLS</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Software desactualizado con vulnerabilidades conocidas</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Entornos de pruebas accesibles desde internet</li></ul></div><div class=\"border-t border-(--h-line) pt-7\"><h2 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Qué recibes</h2><ul class=\"m-0 mt-5 grid list-none gap-3 p-0\"><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Inventario de activos expuestos</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Hallazgos verificados</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Priorización por criticidad</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Plan de reducción de la exposición</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Nueva comprobación de lo corregido durante 6 meses</li></ul></div></div><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14 mt-16 grid gap-10 lg:grid-cols-12\"><div class=\"lg:col-span-7\"><h2 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Cuándo tiene sentido</h2><p class=\"m-0 mt-4 max-w-[60ch] text-[clamp(1.1rem,1.5vw,1.25rem)] leading-[1.55]\">Cuando no sabes con certeza qué tiene publicado tu empresa, tras una migración o adquisición, o como primer paso antes de auditar una aplicación concreta.</p><p class=\"m-0 mt-6 max-w-[60ch] border-l-2 border-(--h-ivory) pl-5 leading-[1.55]\">Las pruebas activas se hacen solo sobre activos autorizados y dentro del alcance firmado.</p></div><div class=\"lg:col-span-5\"><h2 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">En todos los servicios</h2><ul class=\"m-0 mt-4 grid list-none gap-4 p-0\"><li class=\"border-t border-(--h-line) pt-4\"><p class=\"m-0 font-semibold\">Retest durante 6 meses</p><p class=\"m-0 mt-1 text-[15px] leading-[1.55] text-(--h-titanium)\">Cuando corrijas, comprobamos que los fallos críticos y altos están resueltos y te lo dejamos por escrito.</p></li><li class=\"border-t border-(--h-line) pt-4\"><p class=\"m-0 font-semibold\">Propuesta en 48 h laborables</p><p class=\"m-0 mt-1 text-[15px] leading-[1.55] text-(--h-titanium)\">Alcance, plazo y precio cerrados tras la primera conversación.</p></li><li class=\"border-t border-(--h-line) pt-4\"><p class=\"m-0 font-semibold\">Aviso inmediato</p><p class=\"m-0 mt-1 text-[15px] leading-[1.55] text-(--h-titanium)\">Si encontramos algo crítico, te avisamos el mismo día, sin esperar al informe.</p></li><li class=\"border-t border-(--h-line) pt-4\"><p class=\"m-0 font-semibold\">Confidencialidad</p><p class=\"m-0 mt-1 text-[15px] leading-[1.55] text-(--h-titanium)\">Firmamos un acuerdo de confidencialidad si lo necesitas, antes de ver nada.</p></li></ul></div></div></section><section aria-labelledby=\"h-como\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)] bg-(--h-graphite)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><h2 id=\"h-como\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 max-w-[18ch] text-[clamp(1.75rem,4vw,3.25rem)]\">Evaluamos. Priorizamos. Corregimos. Verificamos.</h2><ol class=\"m-0 mt-14 grid list-none gap-10 p-0 sm:grid-cols-2 lg:grid-cols-4\"><li class=\"border-t border-(--h-ivory)/20 pt-6\"><p class=\"m-0 font-semibold uppercase\"><span class=\"mr-3 font-normal tabular-nums text-(--h-titanium)\">01</span>Evaluamos</p><p class=\"m-0 mt-3 leading-[1.6] text-(--h-titanium)\">Comprendemos el contexto, la aplicación y los activos, e identificamos los riesgos dentro de un alcance autorizado.</p></li><li class=\"border-t border-(--h-ivory)/20 pt-6\"><p class=\"m-0 font-semibold uppercase\"><span class=\"mr-3 font-normal tabular-nums text-(--h-titanium)\">02</span>Priorizamos</p><p class=\"m-0 mt-3 leading-[1.6] text-(--h-titanium)\">Clasificamos cada vulnerabilidad por impacto, probabilidad y contexto de negocio. Primero, lo que más te puede costar.</p></li><li class=\"border-t border-(--h-ivory)/20 pt-6\"><p class=\"m-0 font-semibold uppercase\"><span class=\"mr-3 font-normal tabular-nums text-(--h-titanium)\">03</span>Corregimos</p><p class=\"m-0 mt-3 leading-[1.6] text-(--h-titanium)\">Implementamos las medidas necesarias con tu equipo, o te entregamos la corrección lista para tu stack.</p></li><li class=\"border-t border-(--h-ivory)/20 pt-6\"><p class=\"m-0 font-semibold uppercase\"><span class=\"mr-3 font-normal tabular-nums text-(--h-titanium)\">04</span>Verificamos</p><p class=\"m-0 mt-3 leading-[1.6] text-(--h-titanium)\">Volvemos a probar las correcciones de los fallos críticos y altos para confirmar que están cerrados y que no abren otro problema.</p></li></ol><p class=\"m-0 mt-12 max-w-[60ch] leading-[1.55]\">Ninguna prueba activa empieza sin un plan de pruebas firmado. Las que puedan afectar al servicio se hacen en la ventana horaria que acordemos y, si algo se desvía de lo previsto, paramos y te llamamos.</p><a class=\"mt-8 inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 font-medium hover:border-(--h-red) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/#entregables\">Ver un informe de demostración</a></div></section><section aria-labelledby=\"h-otros\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)] border-t border-(--h-line)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><h2 id=\"h-guias\" class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Guías para leer antes</h2><ul class=\"m-0 mt-4 grid list-none gap-1 p-0\"><li><a class=\"inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 hover:border-(--h-red) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/guias/que-incluye-una-auditoria-de-seguridad-web\">Qué incluye una auditoría de seguridad web y de qué depende el precio</a></li><li><a class=\"inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 hover:border-(--h-red) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/guias/que-incluye-una-auditoria-de-seguridad-de-apis\">Qué incluye una auditoría de seguridad de APIs</a></li><li><a class=\"inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 hover:border-(--h-red) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/guias/como-preparar-tu-web-para-una-auditoria-de-seguridad\">Cómo preparar tu web para una auditoría de seguridad</a></li></ul><h2 id=\"h-otros\" class=\"m-0 mt-14 text-[14px] font-normal text-(--h-titanium)\">Otros servicios</h2><ul class=\"m-0 mt-6 grid list-none gap-px bg-(--h-line) p-0 md:grid-cols-2\"><li class=\"bg-(--h-ink)\"><a class=\"group block py-6 md:pr-10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/servicios/auditoria-seguridad-web-api\"><span class=\"block text-[clamp(1.3rem,2vw,1.7rem)] font-semibold uppercase tracking-[-0.015em] underline decoration-transparent decoration-1 underline-offset-8 transition-colors group-hover:decoration-(--h-red) motion-reduce:transition-none\">Auditoría de seguridad web y APIs</span><span class=\"mt-2 block max-w-[48ch] leading-[1.6] text-(--h-titanium)\">Revisamos tu aplicación y sus APIs como lo haría un atacante, con el contexto de quien sabe cómo se construyen.</span></a></li><li class=\"bg-(--h-ink)\"><a class=\"group block py-6 md:pr-10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/servicios/ingenieria-software-segura\"><span class=\"block text-[clamp(1.3rem,2vw,1.7rem)] font-semibold uppercase tracking-[-0.015em] underline decoration-transparent decoration-1 underline-offset-8 transition-colors group-hover:decoration-(--h-red) motion-reduce:transition-none\">Ingeniería de software segura</span><span class=\"mt-2 block max-w-[48ch] leading-[1.6] text-(--h-titanium)\">Trabajamos con tu equipo para que la seguridad forme parte de cómo diseñáis, construís y desplegáis el software.</span></a></li></ul></div></section><section id=\"contacto\" aria-labelledby=\"h-contacto\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)] border-t border-(--h-line)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><h2 id=\"h-contacto\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 max-w-[16ch] text-[clamp(2.4rem,6.4vw,6rem)]\">Cuéntanos qué quieres revisar.</h2><span aria-hidden=\"true\" class=\"mt-10 block h-0.5 w-24 bg-(--h-red)\"></span><div class=\"mt-16 grid gap-16 lg:grid-cols-12 lg:gap-10\"><div class=\"lg:col-span-4\"><p class=\"m-0 max-w-[36ch] text-[clamp(1.1rem,1.5vw,1.3rem)] leading-[1.5]\">Te responde una persona del equipo, no un sistema automático.</p><h3 class=\"m-0 mt-12 text-[14px] font-normal text-(--h-titanium)\">Qué pasa después</h3><ol class=\"m-0 mt-5 grid list-none gap-6 p-0\"><li class=\"grid grid-cols-[2rem_1fr] gap-3 border-t border-(--h-line) pt-5\"><span aria-hidden=\"true\" class=\"tabular-nums text-(--h-titanium)\">1</span><div><p class=\"m-0 font-semibold\">Nos escribes</p><p class=\"m-0 mt-1 leading-[1.55] text-(--h-titanium)\">Con lo que quieres proteger y el contexto. Sin datos sensibles.</p></div></li><li class=\"grid grid-cols-[2rem_1fr] gap-3 border-t border-(--h-line) pt-5\"><span aria-hidden=\"true\" class=\"tabular-nums text-(--h-titanium)\">2</span><div><p class=\"m-0 font-semibold\">Hablamos</p><p class=\"m-0 mt-1 leading-[1.55] text-(--h-titanium)\">Una primera conversación para entender la aplicación, los plazos y lo que necesitas.</p></div></li><li class=\"grid grid-cols-[2rem_1fr] gap-3 border-t border-(--h-line) pt-5\"><span aria-hidden=\"true\" class=\"tabular-nums text-(--h-titanium)\">3</span><div><p class=\"m-0 font-semibold\">Recibes una propuesta</p><p class=\"m-0 mt-1 leading-[1.55] text-(--h-titanium)\">En 48 horas laborables: alcance, plazo y precio cerrados antes de empezar cualquier trabajo.</p></div></li></ol></div><div class=\"lg:col-span-7 lg:col-start-6\"><div class=\"border-l-2 border-(--h-titanium) pl-5\"><h3 class=\"m-0 text-[1.35rem] tracking-[-0.01em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)]\">Solicitar evaluación</h3><p class=\"m-0 mt-6 max-w-[48ch] text-[17px] leading-[1.55]\">El formulario de contacto todavía no está activo.</p></div></div></div></div></section></main><footer class=\"border-t border-(--h-line)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14 grid gap-10 pb-32 pt-14 sm:grid-cols-2 lg:grid-cols-12\"><div class=\"lg:col-span-4\"><span class=\"inline-flex items-baseline font-semibold uppercase leading-none tracking-[0.32em] text-[17px]\">State<span class=\"relative\">X<span aria-hidden=\"true\" class=\"absolute -bottom-[0.28em] left-0 right-[0.32em] h-[0.09em] min-h-px bg-(--h-red)\"></span></span></span><p class=\"m-0 mt-5 max-w-[32ch] text-(--h-titanium)\">Seguridad de aplicaciones, APIs e infraestructura expuesta, con criterio de ingeniería.</p></div><nav aria-label=\"Servicios\" class=\"lg:col-span-3\"><p class=\"m-0 text-[14px] text-(--h-titanium)\">Servicios</p><ul class=\"m-0 mt-3 grid list-none gap-1 p-0\"><li><a class=\"inline-flex min-h-11 items-center text-(--h-ivory)/80 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/servicios/auditoria-seguridad-web-api\">Auditoría de seguridad web y APIs</a></li><li><a class=\"inline-flex min-h-11 items-center text-(--h-ivory)/80 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/servicios/evaluacion-exposicion-externa\">Evaluación de exposición externa</a></li><li><a class=\"inline-flex min-h-11 items-center text-(--h-ivory)/80 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/servicios/ingenieria-software-segura\">Ingeniería de software segura</a></li></ul><p class=\"m-0 mt-6 text-[14px] text-(--h-titanium)\">Guías</p><ul class=\"m-0 mt-3 grid list-none gap-1 p-0\"><li><a class=\"inline-flex min-h-11 items-center text-(--h-ivory)/80 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/guias/que-incluye-una-auditoria-de-seguridad-web\">Qué incluye una auditoría web</a></li><li><a class=\"inline-flex min-h-11 items-center text-(--h-ivory)/80 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/guias/que-incluye-una-auditoria-de-seguridad-de-apis\">Qué incluye una auditoría de APIs</a></li><li><a class=\"inline-flex min-h-11 items-center text-(--h-ivory)/80 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/guias/como-preparar-tu-web-para-una-auditoria-de-seguridad\">Cómo preparar tu web para una auditoría</a></li></u