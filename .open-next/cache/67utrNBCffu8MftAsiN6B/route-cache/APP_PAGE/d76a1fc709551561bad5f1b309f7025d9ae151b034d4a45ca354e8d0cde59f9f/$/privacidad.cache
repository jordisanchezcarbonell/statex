e\":\"twitter:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"19\",{\"name\":\"twitter:image:height\",\"content\":\"630\"}]]}]}],null]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],\"p\":\"$@2b\",\"v\":null,\"s\":\"$6\"}},\"a\":\"$@2c\",\"u\":\"$@2d\",\"b\":\"67utrNBCffu8MftAsiN6B\"}\n2e:I[97367,[\"$2\"],\"OutletBoundary\"]\n:HL[\"/_next/static/chunks/1s-6hrumt1sva.css\",\"style\"]\nd:[\"$\",\"p\",null,{\"children\":\"Esta web solo recoge datos personales cuando nos escribes a través del formulario de contacto o por correo. No usa analítica, publicidad ni seguimiento.\"}]\ne:[\"$\",\"h2\",null,{\"children\":\"Responsable del tratamiento\"}]\nf:[\"$\",\"dl\",null,{\"children\":[[\"$\",\"dt\",null,{\"children\":\"Responsable\"}],[\"$\",\"dd\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-block border border-dashed border-(--h-titanium)/60 px-2 py-1 text-[13px] text-(--h-titanium) \",\"children\":[\"[Pendiente: \",\"nombre y apellidos del titular\",\"]\"]}],\" (nombre comercial: StateX)\"]}],[\"$\",\"dt\",null,{\"children\":\"NIF\"}],[\"$\",\"dd\",null,{\"children\":[\"$\",\"span\",null,{\"className\":\"inline-block border border-dashed border-(--h-titanium)/60 px-2 py-1 text-[13px] text-(--h-titanium) \",\"children\":[\"[Pendiente: \",\"NIF\",\"]\"]}]}],[\"$\",\"dt\",null,{\"children\":\"Domicilio\"}],[\"$\",\"dd\",null,{\"children\":[\"$\",\"span\",null,{\"className\":\"inline-block border border-dashed border-(--h-titanium)/60 px-2 py-1 text-[13px] text-(--h-titanium) \",\"children\":[\"[Pendiente: \",\"domicilio\",\"]\"]}]}],[\"$\",\"dt\",null,{\"children\":\"Contacto\"}],[\"$\",\"dd\",null,{\"children\":[\"$\",\"span\",null,{\"className\":\"inline-block border border-dashed border-(--h-titanium)/60 px-2 py-1 text-[13px] text-(--h-titanium) \",\"children\":[\"[Pendiente: \",\"correo corporativo\",\"]\"]}]}]]}]\n10:[\"$\",\"h2\",null,{\"children\":\"Qué datos tratamos\"}]\n11:[\"$\",\"p\",null,{\"children\":\"Los que nos das en el formulario: nombre, empresa, email de trabajo, cargo (opcional), el tipo de consulta y tu mensaje. No pidas ni envíes por este medio credenciales, datos de clientes ni detalles de vulnerabilidades sin acordar antes un canal seguro.\"}]\n12:[\"$\",\"h2\",null,{\"children\":\"Para qué los usamos\"}]\n13:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Responder a tu solicitud.\"}],[\"$\",\"li\",null,{\"children\":\"Si nos lo pides, preparar una propuesta o una evaluación inicial.\"}]]}]\n14:[\"$\",\"p\",null,{\"children\":\"No los usamos para enviarte comunicaciones comerciales ni para crear perfiles.\"}]\n15:[\"$\",\"h2\",null,{\"children\":\"Base legal\"}]\n16:[\"$\",\"p\",null,{\"children\":\"La aplicación de medidas precontractuales a petición tuya, es decir, responder a tu solicitud y, si lo pides, preparar una propuesta (art. 6.1.b RGPD). La casilla del formulario recoge además tu consentimiento expreso para ese uso (art. 6.1.a RGPD), que puedes retirar cuando quieras.\"}]\n17:[\"$\",\"h2\",null,{\"children\":\"Cuánto tiempo los guardamos\"}]\n18:[\"$\",\"p\",null,{\"children\":[\"El tiempo necesario para atender tu solicitud. Si no llega a haber relación comercial, los borramos como máximo \",[\"$\",\"strong\",null,{\"children\":\"12 meses\"}],\" después de nuestra última comunicación. Si nos contratas, los conservamos mientras dure la relación y, después, durante los plazos que exige la ley para la documentación contable y fiscal; pasado ese tiempo, los eliminamos.\"]}]\n19:[\"$\",\"h2\",null,{\"children\":\"Quién más accede\"}]\n1a:[\"$\",\"p\",null,{\"children\":\"No cedemos tus datos a terceros. Para que la web funcione usamos proveedores que los tratan por cuenta nuestra (encargados del tratamiento):\"}]\n1b:[\"$\",\"ul\",null,{\"children\":[[\"$\",\"li\",null,{\"children\":\"Vercel, alojamiento de la web.\"}],[\"$\",\"li\",null,{\"children\":\"Resend, envío del formulario por correo electrónico.\"}],[\"$\",\"li\",null,{\"children\":[\"$\",\"span\",null,{\"className\":\"inline-block border border-dashed border-(--h-titanium)/60 px-2 py-1 text-[13px] text-(--h-titanium) \",\"children\":\"[Pendiente: proveedor del buzón de correo corporativo]\"}]}]]}]\n1c:[\"$\",\"p\",null,{\"children\":[\"Algunos de estos proveedores pueden tratar datos fuera del Espacio Económico Europeo, con las garantías que exige el RGPD. \",[\"$\",\"span\",null,{\"className\":\"inline-block border border-dashed border-(--h-titanium)/60 px-2 py-1 text-[13px] text-(--h-titanium) \",\"children\":\"[Por confirmar: garantías de transferencia de cada proveedor]\"}]]}]\n1d:[\"$\",\"h2\",null,{\"children\":\"Tus derechos\"}]\n1e:[\"$\",\"p\",null,{\"children\":[\"Puedes pedir acceso, rectificación, supresión, oposición, limitación del tratamiento y portabilidad de tus datos escribiendo a \",[\"$\",\"span\",null,{\"className\":\"inline-block border border-dashed border-(--h-titanium)/60 px-2 py-1 text-[13px] text-(--h-titanium) \",\"children\":[\"[Pendiente: \",\"correo corporativo\",\"]\"]}],\". Si crees que no los hemos tratado bien, puedes reclamar ante la Agencia Española de Protección de Datos (\",[\"$\",\"a\",null,{\"href\":\"https://www.aepd.es\",\"rel\":\"noopener noreferrer\",\"children\":\"aepd.es\"}],\").\"]}]\n1f:[\"$\",\"h2\",null,{\"children\":\"Registros técnicos\"}]\n20:[\"$\",\"p\",null,{\"children\":\"Como cualquier servidor web, el alojamiento registra datos técnicos de las visitas (por ejemplo, la dirección IP) para el funcionamiento y la seguridad del servicio. No los usamos para identificarte.\"}]\n21:[\"$\",\"footer\",null,{\"className\":\"border-t border-(--h-line)\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14 flex flex-wrap items-center justify-between gap-4 py-10 text-[14px] text-(--h-titanium)\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Legal\",\"children\":[\"$\",\"ul\",null,{\"className\":\"m-0 flex list-none flex-wrap 