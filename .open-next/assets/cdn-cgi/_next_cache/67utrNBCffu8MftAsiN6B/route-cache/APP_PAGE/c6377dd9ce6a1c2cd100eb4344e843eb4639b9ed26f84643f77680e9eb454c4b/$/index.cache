 stroke=\"#F2F0EA\" stroke-opacity=\"0.16\"></line></g><g style=\"opacity:0\"><rect x=\"210.71428571428578\" y=\"-111.42857142857139\" width=\"31.249999999999996\" height=\"571.4285714285713\" fill=\"url(#h-fin)\"></rect><rect x=\"1358.0357142857142\" y=\"-111.42857142857139\" width=\"31.249999999999996\" height=\"571.4285714285713\" fill=\"url(#h-fin)\"></rect><line x1=\"241.96428571428578\" y1=\"-111.42857142857139\" x2=\"241.96428571428578\" y2=\"460\" stroke=\"#F2F0EA\" stroke-opacity=\"0.4\"></line><line x1=\"1358.0357142857142\" y1=\"-111.42857142857139\" x2=\"1358.0357142857142\" y2=\"460\" stroke=\"#F2F0EA\" stroke-opacity=\"0.4\"></line><line x1=\"210.71428571428578\" y1=\"-111.42857142857139\" x2=\"1389.2857142857142\" y2=\"-111.42857142857139\" stroke=\"#F2F0EA\" stroke-opacity=\"0.16\"></line></g><g style=\"opacity:0\"><rect x=\"-14.814814814814724\" y=\"-234.4444444444444\" width=\"43.20987654320987\" height=\"790.1234567901233\" fill=\"url(#h-fin)\"></rect><rect x=\"1571.6049382716049\" y=\"-234.4444444444444\" width=\"43.20987654320987\" height=\"790.1234567901233\" fill=\"url(#h-fin)\"></rect><line x1=\"28.39506172839515\" y1=\"-234.4444444444444\" x2=\"28.39506172839515\" y2=\"555.679012345679\" stroke=\"#F2F0EA\" stroke-opacity=\"0.4\"></line><line x1=\"1571.6049382716049\" y1=\"-234.4444444444444\" x2=\"1571.6049382716049\" y2=\"555.679012345679\" stroke=\"#F2F0EA\" stroke-opacity=\"0.4\"></line><line x1=\"-14.814814814814724\" y1=\"-234.4444444444444\" x2=\"1614.8148148148148\" y2=\"-234.4444444444444\" stroke=\"#F2F0EA\" stroke-opacity=\"0.16\"></line></g><g style=\"opacity:0\"><rect x=\"-520\" y=\"-510\" width=\"70\" height=\"1280\" fill=\"url(#h-fin)\"></rect><rect x=\"2050\" y=\"-510\" width=\"70\" height=\"1280\" fill=\"url(#h-fin)\"></rect><line x1=\"-450\" y1=\"-510\" x2=\"-450\" y2=\"770\" stroke=\"#F2F0EA\" stroke-opacity=\"0.4\"></line><line x1=\"2050\" y1=\"-510\" x2=\"2050\" y2=\"770\" stroke=\"#F2F0EA\" stroke-opacity=\"0.4\"></line><line x1=\"-520\" y1=\"-510\" x2=\"2120\" y2=\"-510\" stroke=\"#F2F0EA\" stroke-opacity=\"0.16\"></line></g><line x1=\"634.3888888888889\" x2=\"965.6111111111111\" y1=\"224\" y2=\"224\" stroke=\"#A83A35\" stroke-width=\"2\" style=\"transform-origin:50% 50%;transform-box:view-box;transform:scaleX(0)\"></line></svg></div><div aria-hidden=\"true\" class=\"absolute inset-0 -z-10 bg-[linear-gradient(to_top,var(--h-ink)_6%,color-mix(in_srgb,var(--h-ink)_78%,transparent)_34%,transparent_62%)]\"></div><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14 mt-auto pb-10 pt-40 sm:pb-14\"><h1 id=\"h-hero\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 max-w-[18ch] text-[clamp(1.75rem,5vw,5.25rem)]\"><span class=\"block text-(--h-titanium)\"><span><span class=\"inline-block overflow-hidden pb-[0.08em] align-bottom\"><span class=\"inline-block\" style=\"transform:translateY(105%)\">La</span></span> </span><span><span class=\"inline-block overflow-hidden pb-[0.08em] align-bottom\"><span class=\"inline-block\" style=\"transform:translateY(105%)\">seguridad</span></span> </span><span><span class=\"inline-block overflow-hidden pb-[0.08em] align-bottom\"><span class=\"inline-block\" style=\"transform:translateY(105%)\">no</span></span> </span><span><span class=\"inline-block overflow-hidden pb-[0.08em] align-bottom\"><span class=\"inline-block\" style=\"transform:translateY(105%)\">termina</span></span> </span></span><span class=\"block \"><span><span class=\"inline-block overflow-hidden pb-[0.08em] align-bottom\"><span class=\"inline-block\" style=\"transform:translateY(105%)\">cuando</span></span> </span><span><span class=\"inline-block overflow-hidden pb-[0.08em] align-bottom\"><span class=\"inline-block\" style=\"transform:translateY(105%)\">encuentras</span></span> </span><span><span class=\"inline-block overflow-hidden pb-[0.08em] align-bottom\"><span class=\"inline-block\" style=\"transform:translateY(105%)\">una</span></span> </span><span><span class=\"inline-block overflow-hidden pb-[0.08em] align-bottom\"><span class=\"inline-block\" style=\"transform:translateY(105%)\">vulnerabilidad.</span></span> </span></span></h1><div class=\"mt-10 grid gap-10 lg:grid-cols-12 lg:items-end\" style=\"opacity:0;transform:translateY(12px)\"><p class=\"m-0 max-w-[54ch] text-[clamp(1.05rem,1.4vw,1.2rem)] leading-[1.6] text-(--h-ivory)/80 lg:col-span-6\">Identificamos riesgos, corregimos vulnerabilidades y reforzamos tus sistemas. De la evaluación técnica a la solución.</p><div class=\"flex flex-wrap items-center gap-x-8 gap-y-4 lg:col-span-6 lg:justify-end\"><a href=\"#contacto\" class=\"inline-flex min-h-13 items-center bg-(--h-ivory) px-7 font-medium text-(--h-ink) transition-colors hover:bg-white motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">Solicitar evaluación</a><a href=\"#servicios\" class=\"inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 font-medium transition-colors hover:border-(--h-red) motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">Explorar servicios</a></div></div><div class=\"mt-14 flex flex-wrap justify-between gap-x-8 gap-y-3 border-t border-(--h-line) pt-5 text-[13px] text-(--h-titanium)\"><span>Secure by Design. · Barcelona</span><ul class=\"m-0 flex list-none flex-wrap gap-x-6 gap-y-1 p-0\"><li>Evaluamos</li><li>Priorizamos</li><li>Corregimos</li><li>Verificamos</li></ul></div></div></section><section id=\"servicios\" aria-labelledby=\"h-servicios\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)]\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><div class=\"grid gap-6 lg:grid-cols-12 lg:gap-10\"><p class=\"m-0 flex items-center gap-3 text-[14px] lg:col-span-3 lg:items-start lg:pt-3 text-(--h-titanium)\"><span aria-hidden=\"true\" class=\"h-px w-8 bg-(--h-titanium)/60\"></span>Servicios</p><div class=\"lg:col-span-9\"><h2 id=\"h-servicios\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 text-[clamp(1.75rem,4.6vw,4.25rem)] max-w-[18ch]\">Tres áreas. Del hallazgo a la solución.</h2><p class=\"m-0 mt-7 max-w-[54ch] text-[clamp(1.1rem,1.5vw,1.3rem)] leading-[1.55] text-(--h-titanium)\">Evaluamos como un atacante, corregimos como un equipo de ingeniería y te ayudamos a decidir qué hacer primero. Puedes contratar un área o las tres.</p></div></div><ul class=\"m-0 mt-16 list-none border-b border-(--h-line) p-0 lg:mt-20\"><li class=\"group relative grid gap-10 border-t border-(--h-line) py-12 lg:grid-cols-12 lg:gap-10 lg:py-16\"><span aria-hidden=\"true\" class=\"absolute -top-px left-0 h-0.5 w-full origin-left scale-x-0 bg-(--h-red) transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-focus-within:scale-x-100 group-hover:scale-x-100 motion-reduce:transition-none\"></span><div class=\"lg:col-span-5\"><p class=\"m-0 text-[13px] text-(--h-titanium)\">Evaluación ofensiva autorizada</p><h3 lang=\"en\" class=\"m-0 mt-4 max-w-[14ch] text-[clamp(1.75rem,3vw,2.75rem)] leading-[1.02] tracking-[-0.02em] text-balance [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)]\">Offensive Security</h3><p class=\"m-0 mt-5 max-w-[44ch] text-[17px] leading-[1.6] text-(--h-ivory)/85\">Buscamos lo que encontraría un atacante en tu aplicación, tus APIs y lo que tu empresa expone en internet, siempre dentro del alcance firmado.</p></div><div class=\"lg:col-span-4\"><h4 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Qué incluye</h4><ul class=\"m-0 mt-5 grid list-none gap-3 p-0\"><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Evaluaciones de seguridad</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Pentesting autorizado</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Análisis de vulnerabilidades</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Revisiones de seguridad web y APIs</li></ul></div><div class=\"lg:col-span-3\"><h4 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Por dónde empezar</h4><ul class=\"m-0 mt-5 grid list-none gap-5 p-0\"><li><a class=\"inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 font-medium transition-colors hover:border-(--h-red) motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/servicios/auditoria-seguridad-web-api\">Auditoría de seguridad web y APIs</a><p class=\"m-0 mt-1 text-[14px] tabular-nums text-(--h-titanium)\">Web desde 990 € · API desde 690 € (+ IVA)</p></li><li><a class=\"inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 font-medium transition-colors hover:border-(--h-red) motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/servicios/evaluacion-exposicion-externa\">Evaluación de exposición externa</a><p class=\"m-0 mt-1 text-[14px] tabular-nums text-(--h-titanium)\">Desde 390 € + IVA</p></li></ul></div></li><li class=\"group relative grid gap-10 border-t border-(--h-line) py-12 lg:grid-cols-12 lg:gap-10 lg:py-16\"><span aria-hidden=\"true\" class=\"absolute -top-px left-0 h-0.5 w-full origin-left scale-x-0 bg-(--h-red) transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-focus-within:scale-x-100 group-hover:scale-x-100 motion-reduce:transition-none\"></span><div class=\"lg:col-span-5\"><p class=\"m-0 text-[13px] text-(--h-titanium)\">Ingeniería segura y corrección</p><h3 lang=\"en\" class=\"m-0 mt-4 max-w-[14ch] text-[clamp(1.75rem,3vw,2.75rem)] leading-[1.02] tracking-[-0.02em] text-balance [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)]\">Secure Engineering</h3><p class=\"m-0 mt-5 max-w-[44ch] text-[17px] leading-[1.6] text-(--h-ivory)/85\">Corregimos lo encontrado en tu código, tu configuración o tu arquitectura, y dejamos a tu equipo con un sistema más difícil de romper.</p></div><div class=\"lg:col-span-4\"><h4 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Qué incluye</h4><ul class=\"m-0 mt-5 grid list-none gap-3 p-0\"><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Corrección de vulnerabilidades</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Desarrollo seguro</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Hardening de aplicaciones</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Revisión de autenticación</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Seguridad de APIs</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Mejora de arquitecturas existentes</li></ul></div><div class=\"lg:col-span-3\"><h4 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Por dónde empezar</h4><ul class=\"m-0 mt-5 grid list-none gap-5 p-0\"><li><a class=\"inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 font-medium transition-colors hover:border-(--h-red) motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/servicios/ingenieria-software-segura\">Ingeniería de software segura</a><p class=\"m-0 mt-1 text-[14px] tabular-nums text-(--h-titanium)\">Desde 790 € + IVA</p></li></ul></div></li><li class=\"group relative grid gap-10 border-t border-(--h-line) py-12 lg:grid-cols-12 lg:gap-10 lg:py-16\"><span aria-hidden=\"true\" class=\"absolute -top-px left-0 h-0.5 w-full origin-left scale-x-0 bg-(--h-red) transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-focus-within:scale-x-100 group-hover:scale-x-100 motion-reduce:transition-none\"></span><div class=\"lg:col-span-5\"><p class=\"m-0 text-[13px] text-(--h-titanium)\">Asesoramiento técnico</p><h3 lang=\"en\" class=\"m-0 mt-4 max-w-[14ch] text-[clamp(1.75rem,3vw,2.75rem)] leading-[1.02] tracking-[-0.02em] text-balance [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)]\">Security Advisory</h3><p class=\"m-0 mt-5 max-w-[44ch] text-[17px] leading-[1.6] text-(--h-ivory)/85\">Te ayudamos a decidir con criterio: qué riesgos importan, qué proteger primero y cómo mejorar con el tiempo sin frenar al equipo.</p></div><div class=\"lg:col-span-4\"><h4 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Qué incluye</h4><ul class=\"m-0 mt-5 grid list-none gap-3 p-0\"><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Consultoría de seguridad</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Evaluación de riesgos</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Priorización de medidas de protección</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Asesoramiento de seguridad técnica</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Revisiones de seguimiento puntuales, si se contratan</li></ul></div><div class=\"lg:col-span-3\"><h4 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Por dónde empezar</h4><ul class=\"m-0 mt-5 grid list-none gap-5 p-0\"><li><a href=\"#contacto\" class=\"inline-flex min-h-12 items-center font-medium transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) border-b border-(--h-ivory)/40 hover:border-(--h-red)\">Pedir una evaluación inicial</a><p class=\"m-0 mt-1 text-[14px] tabular-nums text-(--h-titanium)\">290 € + IVA, precio cerrado. Si después contratas una auditoría, te lo descontamos.</p></li></ul></div></li></ul><p class=\"m-0 mt-6 max-w-[70ch] text-[14px] leading-[1.6] text-(--h-titanium)\">Líneas de servicio propuestas. Cada encargo se define con un alcance técnico cerrado y una autorización firmada antes de empezar.</p><div class=\"mt-12 grid gap-6 lg:grid-cols-12 lg:gap-10\"><h3 class=\"m-0 text-[14px] font-normal lg:col-span-3 text-(--h-titanium)\">En todos los servicios</h3><ul class=\"m-0 grid list-none gap-x-10 gap-y-8 p-0 sm:grid-cols-2 lg:col-span-9 lg:grid-cols-4\"><li class=\"border-t border-(--h-line) pt-5\"><p class=\"m-0 font-semibold\">Retest durante 6 meses</p><p class=\"m-0 mt-2 text-[15px] leading-[1.55] text-(--h-titanium)\">Cuando corrijas, comprobamos que los fallos críticos y altos están resueltos y te lo dejamos por escrito.</p></li><li class=\"border-t border-(--h-line) pt-5\"><p class=\"m-0 font-semibold\">Propuesta en 48 h laborables</p><p class=\"m-0 mt-2 text-[15px] leading-[1.55] text-(--h-titanium)\">Alcance, plazo y precio cerrados tras la primera conversación.</p></li><li class=\"border-t border-(--h-line) pt-5\"><p class=\"m-0 font-semibold\">Aviso inmediato</p><p class=\"m-0 mt-2 text-[15px] leading-[1.55] text-(--h-titanium)\">Si encontramos algo crítico, te avisamos el mismo día, sin esperar al informe.</p></li><li class=\"border-t border-(--h-line) pt-5\"><p class=\"m-0 font-semibold\">Confidencialidad</p><p class=\"m-0 mt-2 text-[15px] leading-[1.55] text-(--h-titanium)\">Firmamos un acuerdo de confidencialidad si lo necesitas, antes de ver nada.</p></li></ul></div><div class=\"mt-12 grid gap-px bg-(--h-line) lg:grid-cols-2\"><aside aria-labelledby=\"h-empezar\" class=\"flex flex-col bg-(--h-graphite) p-7 sm:p-10\"><h3 id=\"h-empezar\" class=\"m-0 text-[1.25rem] font-semibold\">¿No sabes por dónde empezar?</h3><p class=\"m-0 mt-3 max-w-[56ch] leading-[1.6] text-(--h-titanium)\">Empieza por una evaluación inicial de alcance limitado: una revisión acotada de tu exposición externa y de tu aplicación principal para decidir, con datos, qué conviene auditar a fondo.</p><p class=\"m-0 mt-4 text-[17px] font-medium tabular-nums\">290 € + IVA, precio cerrado. Si después contratas una auditoría, te lo descontamos.</p><div class=\"mt-auto flex flex-wrap items-center gap-x-8 gap-y-3 pt-8\"><a href=\"#contacto\" class=\"inline-flex min-h-12 items-center font-medium transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) bg-(--h-ivory) px-6 text-(--h-ink) hover:bg-white\">Pedir una evaluación inicial</a></div></aside><aside aria-labelledby=\"h-agencias\" class=\"flex flex-col bg-(--h-graphite) p-7 sm:p-10\"><h3 id=\"h-agencias\" class=\"m-0 text-[1.25rem] font-semibold\">¿Eres una agencia?</h3><p class=\"m-0 mt-3 max-w-[56ch] leading-[1.6] text-(--h-titanium)\">Revisamos la exposición externa y la web pública (sin login) de 5 webs de tus clientes. Un informe por web, uno resumen para la agencia y, si lo prefieres, con tu marca.</p><p class=\"m-0 mt-4 text-[17px] font-medium tabular-nums\">5 webs por 1.290 € + IVA. Cada web adicional, 240 €.</p><p class=\"m-0 mt-2 text-[14px] text-(--h-titanium)\">Cada cliente final firma la autorización de sus activos.</p><div class=\"mt-auto flex flex-wrap items-center gap-x-8 gap-y-3 pt-8\"><a href=\"#contacto\" class=\"inline-flex min-h-12 items-center font-medium transition-colors motion-reduce:transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) bg-(--h-ivory) px-6 text-(--h-ink) hover:bg-white\">Pedir el pack para agencias</a><a href=\"/resumen-agencia-de-ejemplo.html\" class=\"inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 hover:border-(--h-red) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">Ver un resumen de ejemplo</a></div></aside></div></div></section><section id=\"metodo\" aria-labelledby=\"h-metodo\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)] border-t border-(--h-line)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><div class=\"grid gap-6 lg:grid-cols-12 lg:gap-10\"><p class=\"m-0 flex items-center gap-3 text-[14px] lg:col-span-3 lg:items-start lg:pt-3 text-(--h-titanium)\"><span aria-hidden=\"true\" class=\"h-px w-8 bg-(--h-titanium)/60\"></span>Nuestro método</p><div class=\"lg:col-span-9\"><h2 id=\"h-metodo\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 text-[clamp(1.75rem,4.6vw,4.25rem)] max-w-[18ch]\">Evaluamos. Priorizamos. Corregimos. Verificamos.</h2><p class=\"m-0 mt-7 max-w-[54ch] text-[clamp(1.1rem,1.5vw,1.3rem)] leading-[1.55] text-(--h-titanium)\">Cuatro fases acotadas y trazables. Sabes qué se va a probar, cuándo, qué recibirás y cómo comprobamos que el problema ya no existe.</p></div></div><div class=\"relative mt-16 lg:mt-24\"><div aria-hidden=\"true\" class=\"absolute left-0 top-0 hidden h-px w-full bg-(--h-line) lg:block\"><div class=\"h-px origin-left bg-(--h-red)\" style=\"transform:scaleX(0)\"></div></div><div aria-hidden=\"true\" class=\"absolute bottom-0 left-0 top-0 w-px bg-(--h-line) lg:hidden\"><div class=\"h-full w-px origin-top bg-(--h-red)\" style=\"transform:scaleY(0)\"></div></div><ol class=\"m-0 grid list-none gap-12 p-0 pl-8 lg:grid-cols-4 lg:gap-0 lg:pl-0\"><li class=\"flex flex-col lg:border-l lg:border-(--h-line) lg:px-8 lg:pt-10 lg:first:border-l-0 lg:first:pl-0\"><span aria-hidden=\"true\" class=\"block text-[clamp(2.75rem,4vw,4rem)] font-extralight leading-none tabular-nums tracking-[-0.04em] text-(--h-titanium)\">01</span><h3 class=\"m-0 mt-6 text-[1.2rem] tracking-[0.01em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)]\"><span class=\"sr-only\">Fase <!-- -->1<!-- -->: </span>Evaluamos</h3><p class=\"m-0 mt-3 max-w-[36ch] leading-[1.6] text-(--h-titanium)\">Comprendemos el contexto, la aplicación y los activos, e identificamos los riesgos dentro de un alcance autorizado.</p><p class=\"m-0 mt-6 border-t border-(--h-line) pt-4 text-[14px] lg:mt-auto\"><span class=\"block text-[13px] text-(--h-titanium)\">Queda por escrito</span><span class=\"mt-1 block\">Alcance, autorización y registro de pruebas</span></p></li><li class=\"flex flex-col lg:border-l lg:border-(--h-line) lg:px-8 lg:pt-10 lg:first:border-l-0 lg:first:pl-0\"><span aria-hidden=\"true\" class=\"block text-[clamp(2.75rem,4vw,4rem)] font-extralight leading-none tabular-nums tracking-[-0.04em] text-(--h-titanium)\">02</span><h3 class=\"m-0 mt-6 text-[1.2rem] tracking-[0.01em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)]\"><span class=\"sr-only\">Fase <!-- -->2<!-- -->: </span>Priorizamos</h3><p class=\"m-0 mt-3 max-w-[36ch] leading-[1.6] text-(--h-titanium)\">Clasificamos cada vulnerabilidad por impacto, probabilidad y contexto de negocio. Primero, lo que más te puede costar.</p><p class=\"m-0 mt-6 border-t border-(--h-line) pt-4 text-[14px] lg:mt-auto\"><span class=\"block text-[13px] text-(--h-titanium)\">Queda por escrito</span><span class=\"mt-1 block\">Informe técnico y resumen ejecutivo</span></p></li><li class=\"flex flex-col lg:border-l lg:border-(--h-line) lg:px-8 lg:pt-10 lg:first:border-l-0 lg:first:pl-0\"><span aria-hidden=\"true\" class=\"block text-[clamp(2.75rem,4vw,4rem)] font-extralight leading-none tabular-nums tracking-[-0.04em] text-(--h-titanium)\">03</span><h3 class=\"m-0 mt-6 text-[1.2rem] tracking-[0.01em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)]\"><span class=\"sr-only\">Fase <!-- -->3<!-- -->: </span>Corregimos</h3><p class=\"m-0 mt-3 max-w-[36ch] leading-[1.6] text-(--h-titanium)\">Implementamos las medidas necesarias con tu equipo, o te entregamos la corrección lista para tu stack.</p><p class=\"m-0 mt-6 border-t border-(--h-line) pt-4 text-[14px] lg:mt-auto\"><span class=\"block text-[13px] text-(--h-titanium)\">Queda por escrito</span><span class=\"mt-1 block\">Plan de corrección y cambios aplicados</span></p></li><li class=\"flex flex-col lg:border-l lg:border-(--h-line) lg:px-8 lg:pt-10 lg:first:border-l-0 lg:first:pl-0\"><span aria-hidden=\"true\" class=\"block text-[clamp(2.75rem,4vw,4rem)] font-extralight leading-none tabular-nums tracking-[-0.04em] text-(--h-titanium)\">04</span><h3 class=\"m-0 mt-6 text-[1.2rem] tracking-[0.01em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)]\"><span class=\"sr-only\">Fase <!-- -->4<!-- -->: </span>Verificamos</h3><p class=\"m-0 mt-3 max-w-[36ch] leading-[1.6] text-(--h-titanium)\">Volvemos a probar las correcciones de los fallos críticos y altos para confirmar que están cerrados y que no abren otro problema.</p><p class=\"m-0 mt-6 border-t border-(--h-line) pt-4 text-[14px] lg:mt-auto\"><span class=\"block text-[13px] text-(--h-titanium)\">Queda por escrito</span><span class=\"mt-1 block\">Retest de críticos y altos durante 6 meses</span></p></li></ol></div><p class=\"m-0 mt-14 max-w-[60ch] border-l-2 border-(--h-ivory) pl-5 text-[clamp(1.05rem,1.4vw,1.2rem)] leading-[1.5] lg:ml-[calc(25%+0.625rem)]\">Ninguna prueba activa empieza sin un plan de pruebas firmado. Las que puedan afectar al servicio se hacen en la ventana horaria que acordemos y, si algo se desvía de lo previsto, paramos y te llamamos.</p></div></section><section id=\"por-que\" aria-labelledby=\"h-por-que\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)] bg-(--h-graphite)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><div class=\"grid gap-6 lg:grid-cols-12 lg:gap-10\"><p class=\"m-0 flex items-center gap-3 text-[14px] lg:col-span-3 lg:items-start lg:pt-3 text-(--h-titanium)\"><span aria-hidden=\"true\" class=\"h-px w-8 bg-(--h-titanium)/60\"></span>Por qué elegirnos</p><div class=\"lg:col-span-9\"><h2 id=\"h-por-que\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 text-[clamp(1.75rem,4.6vw,4.25rem)] max-w-[18ch]\">Encontrar el fallo es solo la mitad del trabajo.</h2><p class=\"m-0 mt-7 max-w-[54ch] text-[clamp(1.1rem,1.5vw,1.3rem)] leading-[1.55] text-(--h-titanium)\">Muchas consultoras entregan una lista de vulnerabilidades. En StateX la seguridad y la ingeniería trabajan juntas, así que, si lo contratas, el encargo termina cuando el problema está resuelto y comprobado.</p></div></div><ul class=\"m-0 mt-16 grid list-none gap-x-10 gap-y-12 p-0 sm:grid-cols-2 lg:mt-20 lg:grid-cols-3\"><li class=\"border-t border-(--h-ivory)/20 pt-7\"><h3 class=\"m-0 text-[1.1rem] font-semibold\">Seguridad e ingeniería, juntas</h3><p class=\"m-0 mt-3 leading-[1.6] text-(--h-titanium)\">Un especialista en seguridad y un ingeniero de software en la misma firma, desde la primera conversación.</p></li><li class=\"border-t border-(--h-ivory)/20 pt-7\"><h3 class=\"m-0 text-[1.1rem] font-semibold\">No nos quedamos en el informe</h3><p class=\"m-0 mt-3 leading-[1.6] text-(--h-titanium)\">Si lo contratas, aplicamos la corrección: código, configuración o arquitectura.</p></li><li class=\"border-t border-(--h-ivory)/20 pt-7\"><h3 class=\"m-0 text-[1.1rem] font-semibold\">Soluciones técnicas reales</h3><p class=\"m-0 mt-3 leading-[1.6] text-(--h-titanium)\">Correcciones pensadas para tu stack y tu forma de desplegar, no enlaces a una guía genérica.</p></li><li class=\"border-t border-(--h-ivory)/20 pt-7\"><h3 class=\"m-0 text-[1.1rem] font-semibold\">Prioridad por riesgo e impacto</h3><p class=\"m-0 mt-3 leading-[1.6] text-(--h-titanium)\">Primero lo que puede costarte datos, dinero o clientes. Después, el resto, con un plan.</p></li><li class=\"border-t border-(--h-ivory)/20 pt-7\"><h3 class=\"m-0 text-[1.1rem] font-semibold\">Resultados que se entienden</h3><p class=\"m-0 mt-3 leading-[1.6] text-(--h-titanium)\">Un resumen para dirección, que decide, y el detalle técnico para el equipo que corrige.</p></li><li class=\"border-t border-(--h-ivory)/20 pt-7\"><h3 class=\"m-0 text-[1.1rem] font-semibold\">Alcance definido y autorizado</h3><p class=\"m-0 mt-3 leading-[1.6] text-(--h-titanium)\">Ninguna prueba activa sin autorización escrita, alcance firmado y ventana horaria acordada.</p></li></ul></div></section><section id=\"entregables\" aria-labelledby=\"h-entregables\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)]\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><div class=\"grid gap-6 lg:grid-cols-12 lg:gap-10\"><p class=\"m-0 flex items-center gap-3 text-[14px] lg:col-span-3 lg:items-start lg:pt-3 text-(--h-titanium)\"><span aria-hidden=\"true\" class=\"h-px w-8 bg-(--h-titanium)/60\"></span>Entregables</p><div class=\"lg:col-span-9\"><h2 id=\"h-entregables\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 text-[clamp(1.75rem,4.6vw,4.25rem)] max-w-[18ch]\">Qué recibe tu empresa.</h2><p class=\"m-0 mt-7 max-w-[54ch] text-[clamp(1.1rem,1.5vw,1.3rem)] leading-[1.55] text-(--h-titanium)\">Míralo antes de contratar. Un informe pensado para dos lectores: dirección, que necesita decidir, y el equipo técnico, que necesita corregir.</p></div></div><div class=\"mt-16 grid grid-cols-[minmax(0,1fr)] gap-12 lg:mt-20 lg:grid-cols-12 lg:gap-10\"><div class=\"lg:col-span-3\"><h3 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Qué incluye</h3><ul class=\"m-0 mt-5 grid list-none gap-3 p-0\"><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Resumen ejecutivo</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Inventario de hallazgos</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Severidad y prioridad de cada uno</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Evidencias reproducibles</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Impacto para el negocio</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Recomendaciones de corrección</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Plan de remediación por fases</li></ul><div class=\"mt-10 grid justify-items-start gap-1\"><a href=\"/informe-de-ejemplo.html\" class=\"inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 font-medium hover:border-(--h-red) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">Ver el informe de ejemplo completo</a><a href=\"/informe-de-ejemplo.pdf\" download=\"\" class=\"inline-flex min-h-11 items-center text-[15px] text-(--h-ivory)/75 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">Descargar en PDF<span class=\"ml-2 text-[13px] text-(--h-titanium)\">(<!-- -->8 páginas · datos ficticios<!-- -->)</span></a></div><p class=\"m-0 mt-8 max-w-[34ch] text-[13px] leading-[1.6] text-(--h-titanium)\">Informe de demostración: ni el dominio, ni la aplicación, ni los hallazgos corresponden a un cliente real.</p></div><article aria-labelledby=\"h-informe-doc\" class=\"bg-(--h-ivory) p-6 text-(--h-ink) shadow-[0_40px_80px_-40px_rgba(0,0,0,0.8)] sm:p-10 lg:col-span-9 xl:p-14\"><header class=\"flex flex-wrap items-center justify-between gap-3 pb-5\"><span class=\"text-[13px]\"><span class=\"inline-flex items-baseline font-semibold uppercase leading-none tracking-[0.32em] \">State<span class=\"relative\">X<span aria-hidden=\"true\" class=\"absolute -bottom-[0.28em] left-0 right-[0.32em] h-[0.09em] min-h-px bg-(--h-red)\"></span></span></span></span><span class=\"border border-(--h-ink) px-2 py-1 text-[13px] font-medium uppercase tracking-[0.08em]\">Demostración · datos ficticios</span></header><span aria-hidden=\"true\" class=\"block h-0.5 w-full bg-(--h-red)\"></span><div class=\"mt-8 grid gap-8 md:grid-cols-[1fr_auto] md:items-end\"><div><p class=\"m-0 text-[13px] font-medium uppercase tracking-[0.08em] text-(--h-stone)\">Versión 1.0 · Confidencial</p><h3 id=\"h-informe-doc\" class=\"m-0 mt-3 text-[clamp(1.5rem,2.6vw,2.25rem)] font-semibold uppercase leading-[1.02] tracking-[-0.02em] text-balance\">Auditoría de seguridad web y APIs</h3><p class=\"m-0 mt-3 font-mono text-[13px] text-(--h-stone)\">app.ejemplo.com · api.ejemplo.com</p></div><dl class=\"m-0 grid grid-cols-3 gap-px bg-(--h-paper-line) text-center\"><div class=\"bg-(--h-ivory) px-4 py-2 sm:px-5\"><dt class=\"text-[13px] text-(--h-stone)\">Alta</dt><dd class=\"m-0 text-[1.75rem] font-light leading-tight tabular-nums\">2</dd></div><div class=\"bg-(--h-ivory) px-4 py-2 sm:px-5\"><dt class=\"text-[13px] text-(--h-stone)\">Media</dt><dd class=\"m-0 text-[1.75rem] font-light leading-tight tabular-nums\">1</dd></div><div class=\"bg-(--h-ivory) px-4 py-2 sm:px-5\"><dt class=\"text-[13px] text-(--h-stone)\">Baja</dt><dd class=\"m-0 text-[1.75rem] font-light leading-tight tabular-nums\">1</dd></div></dl></div><section aria-labelledby=\"h-informe-resumen\" class=\"mt-10 grid gap-3 border-t border-(--h-paper-line) pt-6 md:grid-cols-[11rem_1fr] md:gap-8\"><h4 id=\"h-informe-resumen\" class=\"m-0 text-[13px] font-medium uppercase tracking-[0.08em] text-(--h-stone)\">Resumen ejecutivo</h4><p class=\"m-0 max-w-[62ch] text-[17px] leading-[1.6]\">La aplicación protege bien el acceso, pero dos fallos de autorización permiten a un usuario consultar o modificar datos de otras cuentas. Recomendamos corregirlos antes del próximo lanzamiento.</p></section><section aria-labelledby=\"h-informe-hallazgos\" class=\"mt-10 border-t border-(--h-paper-line) pt-6\"><h4 id=\"h-informe-hallazgos\" class=\"m-0 text-[13px] font-medium uppercase tracking-[0.08em] text-(--h-stone)\">Inventario de hallazgos</h4><table class=\"mt-4 hidden w-full border-collapse text-left text-[15px] sm:table\"><thead><tr class=\"text-[13px] text-(--h-stone)\"><th scope=\"col\" class=\"py-2 pr-4 font-normal\">ID</th><th scope=\"col\" class=\"py-2 pr-4 font-normal\">Hallazgo</th><th scope=\"col\" class=\"py-2 pr-4 font-normal\">Severidad</th><th scope=\"col\" class=\"py-2 font-normal\">Prioridad</th></tr></thead><tbody><tr class=\"border-t border-(--h-paper-line)\"><td class=\"py-3 pr-4 align-top font-mono text-[13px] tabular-nums\">SX-01</td><td class=\"py-3 pr-4 align-top\"><span class=\"block font-medium leading-[1.35]\">Acceso a facturas de otras cuentas cambiando el identificador</span><span class=\"mt-1 block font-mono text-[13px] text-(--h-stone)\">GET /api/v1/invoices/{id}</span></td><td class=\"py-3 pr-4 align-top\"><span class=\"inline-flex items-center gap-2 whitespace-nowrap\"><span aria-hidden=\"true\" class=\"inline-flex gap-[3px]\"><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span></span>Alta</span></td><td class=\"py-3 align-top text-(--h-stone)\">Inmediata</td></tr><tr class=\"border-t border-(--h-paper-line)\"><td class=\"py-3 pr-4 align-top font-mono text-[13px] tabular-nums\">SX-02</td><td class=\"py-3 pr-4 align-top\"><span class=\"block font-medium leading-[1.35]\">Un usuario sin rol de administración puede invitar administradores</span><span class=\"mt-1 block font-mono text-[13px] text-(--h-stone)\">POST /api/v1/team/invite</span></td><td class=\"py-3 pr-4 align-top\"><span class=\"inline-flex items-center gap-2 whitespace-nowrap\"><span aria-hidden=\"true\" class=\"inline-flex gap-[3px]\"><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span></span>Alta</span></td><td class=\"py-3 align-top text-(--h-stone)\">Inmediata</td></tr><tr class=\"border-t border-(--h-paper-line)\"><td class=\"py-3 pr-4 align-top font-mono text-[13px] tabular-nums\">SX-03</td><td class=\"py-3 pr-4 align-top\"><span class=\"block font-medium leading-[1.35]\">Sin límite de intentos en el inicio de sesión</span><span class=\"mt-1 block font-mono text-[13px] text-(--h-stone)\">POST /api/v1/auth/login</span></td><td class=\"py-3 pr-4 align-top\"><span class=\"inline-flex items-center gap-2 whitespace-nowrap\"><span aria-hidden=\"true\" class=\"inline-flex gap-[3px]\"><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-paper-line)\"></span></span>Media</span></td><td class=\"py-3 align-top text-(--h-stone)\">Próximo sprint</td></tr><tr class=\"border-t border-(--h-paper-line)\"><td class=\"py-3 pr-4 align-top font-mono text-[13px] tabular-nums\">SX-04</td><td class=\"py-3 pr-4 align-top\"><span class=\"block font-medium leading-[1.35]\">Cabeceras de seguridad incompletas</span><span class=\"mt-1 block font-mono text-[13px] text-(--h-stone)\">app.ejemplo.com</span></td><td class=\"py-3 pr-4 align-top\"><span class=\"inline-flex items-center gap-2 whitespace-nowrap\"><span aria-hidden=\"true\" class=\"inline-flex gap-[3px]\"><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-paper-line)\"></span><span class=\"h-3 w-1.5 bg-(--h-paper-line)\"></span></span>Baja</span></td><td class=\"py-3 align-top text-(--h-stone)\">Planificada</td></tr></tbody></table><ul class=\"m-0 mt-4 list-none p-0 sm:hidden\"><li class=\"border-t border-(--h-paper-line) py-4\"><p class=\"m-0 font-medium leading-[1.35]\"><span class=\"font-mono text-[13px] tabular-nums\">SX-01</span> · <!-- -->Acceso a facturas de otras cuentas cambiando el identificador</p><p class=\"m-0 mt-1 font-mono text-[13px] text-(--h-stone)\">GET /api/v1/invoices/{id}</p><dl class=\"m-0 mt-2 flex flex-wrap gap-x-6 gap-y-1 text-[14px]\"><div class=\"flex gap-2\"><dt class=\"text-(--h-stone)\">Severidad</dt><dd class=\"m-0\"><span class=\"inline-flex items-center gap-2 whitespace-nowrap\"><span aria-hidden=\"true\" class=\"inline-flex gap-[3px]\"><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span></span>Alta</span></dd></div><div class=\"flex gap-2\"><dt class=\"text-(--h-stone)\">Prioridad</dt><dd class=\"m-0\">Inmediata</dd></div></dl></li><li class=\"border-t border-(--h-paper-line) py-4\"><p class=\"m-0 font-medium leading-[1.35]\"><span class=\"font-mono text-[13px] tabular-nums\">SX-02</span> · <!-- -->Un usuario sin rol de administración puede invitar administradores</p><p class=\"m-0 mt-1 font-mono text-[13px] text-(--h-stone)\">POST /api/v1/team/invite</p><dl class=\"m-0 mt-2 flex flex-wrap gap-x-6 gap-y-1 text-[14px]\"><div class=\"flex gap-2\"><dt class=\"text-(--h-stone)\">Severidad</dt><dd class=\"m-0\"><span class=\"inline-flex items-center gap-2 whitespace-nowrap\"><span aria-hidden=\"true\" class=\"inline-flex gap-[3px]\"><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span></span>Alta</span></dd></div><div class=\"flex gap-2\"><dt class=\"text-(--h-stone)\">Prioridad</dt><dd class=\"m-0\">Inmediata</dd></div></dl></li><li class=\"border-t border-(--h-paper-line) py-4\"><p class=\"m-0 font-medium leading-[1.35]\"><span class=\"font-mono text-[13px] tabular-nums\">SX-03</span> · <!-- -->Sin límite de intentos en el inicio de sesión</p><p class=\"m-0 mt-1 font-mono text-[13px] text-(--h-stone)\">POST /api/v1/auth/login</p><dl class=\"m-0 mt-2 flex flex-wrap gap-x-6 gap-y-1 text-[14px]\"><div class=\"flex gap-2\"><dt class=\"text-(--h-stone)\">Severidad</dt><dd class=\"m-0\"><span class=\"inline-flex items-center gap-2 whitespace-nowrap\"><span aria-hidden=\"true\" class=\"inline-flex gap-[3px]\"><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-paper-line)\"></span></span>Media</span></dd></div><div class=\"flex gap-2\"><dt class=\"text-(--h-stone)\">Prioridad</dt><dd class=\"m-0\">Próximo sprint</dd></div></dl></li><li class=\"border-t border-(--h-paper-line) py-4\"><p class=\"m-0 font-medium leading-[1.35]\"><span class=\"font-mono text-[13px] tabular-nums\">SX-04</span> · <!-- -->Cabeceras de seguridad incompletas</p><p class=\"m-0 mt-1 font-mono text-[13px] text-(--h-stone)\">app.ejemplo.com</p><dl class=\"m-0 mt-2 flex flex-wrap gap-x-6 gap-y-1 text-[14px]\"><div class=\"flex gap-2\"><dt class=\"text-(--h-stone)\">Severidad</dt><dd class=\"m-0\"><span class=\"inline-flex items-center gap-2 whitespace-nowrap\"><span aria-hidden=\"true\" class=\"inline-flex gap-[3px]\"><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-paper-line)\"></span><span class=\"h-3 w-1.5 bg-(--h-paper-line)\"></span></span>Baja</span></dd></div><div class=\"flex gap-2\"><dt class=\"text-(--h-stone)\">Prioridad</dt><dd class=\"m-0\">Planificada</dd></div></dl></li></ul></section><section aria-labelledby=\"h-informe-detalle\" class=\"mt-10 border-t border-(--h-paper-line) pt-6\"><h4 id=\"h-informe-detalle\" class=\"m-0 text-[13px] font-medium uppercase tracking-[0.08em] text-(--h-stone)\">Detalle del hallazgo<!-- --> · <!-- -->SX-01</h4><p class=\"m-0 mt-3 text-[1.15rem] font-semibold leading-[1.3]\">Acceso a facturas de otras cuentas cambiando el identificador</p><div class=\"mt-6 grid grid-cols-[minmax(0,1fr)] gap-8 md:grid-cols-2\"><figure class=\"m-0\"><figcaption class=\"text-[13px] text-(--h-stone)\">Evidencia</figcaption><pre tabindex=\"0\" role=\"region\" aria-label=\"Evidencia\" class=\"m-0 mt-2 overflow-x-auto bg-(--h-ink) p-4 font-mono text-[13px] leading-[1.7] text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) focus-visible:outline-(--h-ink)\">GET /api/v1/invoices/10482 HTTP/1.1\nHost: api.ejemplo.com\nAuthorization: Bearer &lt;sesión de la cuenta A&gt;\n\n200 OK · factura de la cuenta B</pre></figure><dl class=\"m-0 grid content-start gap-5\"><div><dt class=\"text-[13px] text-(--h-stone)\">Impacto</dt><dd class=\"m-0 mt-1 leading-[1.55]\">Cualquier usuario registrado puede descargar facturas de otros clientes, con sus datos fiscales.</dd></div><div><dt class=\"text-[13px] text-(--h-stone)\">Recomendación</dt><dd class=\"m-0 mt-1 leading-[1.55]\">Comprobar en el servidor que la factura pertenece a la cuenta de la sesión antes de devolverla.</dd></div><div><dt class=\"text-[13px] text-(--h-stone)\">Prioridad</dt><dd class=\"m-0 mt-1\"><span class=\"inline-flex items-center gap-2 whitespace-nowrap\"><span aria-hidden=\"true\" class=\"inline-flex gap-[3px]\"><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span><span class=\"h-3 w-1.5 bg-(--h-ink)\"></span></span>Alta</span> · <!-- -->Inmediata</dd></div></dl></div><p class=\"m-0 mt-8 text-[13px] text-(--h-stone)\">3<!-- --> hallazgos más en el informe · <!-- -->Demostración · datos ficticios</p></section></article></div></div></section><section id=\"equipo\" aria-labelledby=\"h-equipo\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)] border-t border-(--h-line)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><div class=\"grid gap-6 lg:grid-cols-12 lg:gap-10\"><p class=\"m-0 flex items-center gap-3 text-[14px] lg:col-span-3 lg:items-start lg:pt-3 text-(--h-titanium)\"><span aria-hidden=\"true\" class=\"h-px w-8 bg-(--h-titanium)/60\"></span>Quiénes somos</p><div class=\"lg:col-span-9\"><h2 id=\"h-equipo\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 text-[clamp(1.75rem,4.6vw,4.25rem)] max-w-[18ch]\">Dos perfiles complementarios. Un mismo encargo.</h2><p class=\"m-0 mt-7 max-w-[54ch] text-[clamp(1.1rem,1.5vw,1.3rem)] leading-[1.55] text-(--h-titanium)\">StateX la forman [retirado]: uno viene de la ciberseguridad y el otro de la ingeniería de software. Quien te propone el alcance es quien hace el trabajo y te presenta los resultados.</p></div></div><div class=\"mt-16 grid gap-12 lg:mt-20 lg:grid-cols-9 lg:gap-10 lg:ml-[calc(25%+0.625rem)]\"><ul class=\"m-0 grid list-none gap-8 p-0 sm:grid-cols-2 lg:col-span-5\"><li class=\"border-t border-(--h-line) pt-6\"><h3 class=\"m-0 text-[clamp(1.3rem,2vw,1.6rem)] tracking-[-0.015em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)]\">[retirado]</h3><p class=\"m-0 mt-1 text-(--h-titanium)\">Cofundador · Seguridad</p><p class=\"m-0 mt-4 max-w-[40ch] leading-[1.6]\">[retirado]</p><p class=\"m-0 mt-3 max-w-[40ch] leading-[1.6] text-(--h-titanium)\">[retirado]</p><ul class=\"m-0 mt-4 flex list-none flex-wrap gap-x-5 p-0\"><li><a href=\"[retirado]\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 hover:border-(--h-red) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">LinkedIn<span class=\"sr-only\"> de <!-- -->[retirado]<!-- --> (se abre en una pestaña nueva)</span></a></li></ul></li><li class=\"border-t border-(--h-line) pt-6\"><h3 class=\"m-0 text-[clamp(1.3rem,2vw,1.6rem)] tracking-[-0.015em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)]\">Jordi Sánchez</h3><p class=\"m-0 mt-1 text-(--h-titanium)\">Cofundador · Ingeniería</p><p class=\"m-0 mt-4 max-w-[40ch] leading-[1.6]\">Desarrollador full stack desde 2020, con React, Next.js y NestJS. Antes, asesor en seguridad web. Aporta la mirada de quien construye y mantiene las aplicaciones que auditamos.</p><p class=\"m-0 mt-3 max-w-[40ch] leading-[1.6] text-(--h-titanium)\">Responsable del desarrollo seguro, la corrección de vulnerabilidades y las soluciones técnicas.</p><ul class=\"m-0 mt-4 flex list-none flex-wrap gap-x-5 p-0\"><li><a href=\"https://www.linkedin.com/in/jordi-s%C3%A1nchez-carbonell-baa83797/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-flex min-h-11 items-center border-b border-(--h-ivory)/40 hover:border-(--h-red) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\">LinkedIn<span class=\"sr-only\"> de <!-- -->Jordi Sánchez<!-- --> (se abre en una pestaña nueva)</span></a></li></ul></li></ul><div class=\"lg:col-span-4\"><h3 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Experiencia del equipo</h3><ul class=\"m-0 mt-5 grid list-none gap-x-8 gap-y-3 p-0 sm:grid-cols-2 lg:grid-cols-1\"><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Consultoría y gestión de proyectos de ciberseguridad</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Pentesting y seguridad web</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>React, Next.js y TypeScript</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>APIs REST e integraciones empresariales</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Autenticación y control de acceso</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Arquitectura de aplicaciones</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Infraestructura y despliegues</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Corrección de vulnerabilidades en aplicaciones</li><li class=\"grid grid-cols-[1rem_1fr] gap-3 leading-[1.5]\"><span aria-hidden=\"true\" class=\"mt-[0.75em] h-px w-full bg-(--h-titanium)\"></span>Automatización e inteligencia artificial</li></ul></div></div></div></section><section id=\"trayectoria\" aria-labelledby=\"h-trayectoria\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)] border-t border-(--h-line)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><div class=\"grid gap-6 lg:grid-cols-12 lg:gap-10\"><p class=\"m-0 flex items-center gap-3 text-[14px] lg:col-span-3 lg:items-start lg:pt-3 text-(--h-titanium)\"><span aria-hidden=\"true\" class=\"h-px w-8 bg-(--h-titanium)/60\"></span>Trayectoria</p><div class=\"lg:col-span-9\"><h2 id=\"h-trayectoria\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 text-[clamp(1.75rem,4.6vw,4.25rem)] max-w-[18ch]\">La curiosidad nos trajo hasta aquí. El rigor define lo que hacemos ahora.</h2><p class=\"m-0 mt-7 max-w-[54ch] text-[clamp(1.1rem,1.5vw,1.3rem)] leading-[1.55] text-(--h-titanium)\">StateX nació en 2012 como el blog personal de [retirado] sobre seguridad informática, y en 2013 Jordi sumó DoubleReboot. No era una empresa: era curiosidad, herramientas y muchas horas de pruebas. Hoy esa curiosidad trabaja con método, alcance y contrato.</p></div></div><div class=\"mt-16 grid gap-px bg-(--h-line) lg:mt-20 lg:grid-cols-9 lg:ml-[calc(25%+0.625rem)]\"><div class=\"bg-(--h-ink) py-8 lg:col-span-5 lg:pr-10\"><h3 class=\"m-0 flex flex-wrap items-baseline justify-between gap-3 text-[14px] font-normal\"><span class=\"text-(--h-titanium)\">Proyectos originales</span><span class=\"tabular-nums text-(--h-titanium)\">2012 – 2018</span></h3><ul class=\"m-0 mt-4 list-none p-0\"><li class=\"border-t border-(--h-line)\"><a href=\"https://infostatex.blogspot.com/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group block py-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\"><span class=\"flex flex-wrap items-baseline justify-between gap-3\"><span class=\"text-[clamp(1.4rem,2.2vw,1.9rem)] tracking-[-0.02em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)] underline decoration-transparent decoration-1 underline-offset-8 transition-colors group-hover:decoration-(--h-red) motion-reduce:transition-none\">InfoStateX<span class=\"sr-only\"> (se abre en una pestaña nueva)</span></span><span class=\"text-[14px] tabular-nums text-(--h-titanium)\">2012 – 2018</span></span><span class=\"mt-2 block max-w-[52ch] leading-[1.6] text-(--h-titanium)\">El blog de [retirado] sobre hacking, curiosidades y seguridad informática, con más de 1.300 entradas.</span></a></li><li class=\"border-t border-(--h-line)\"><a href=\"https://doublereboot.blogspot.com/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"group block py-6 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\"><span class=\"flex flex-wrap items-baseline justify-between gap-3\"><span class=\"text-[clamp(1.4rem,2.2vw,1.9rem)] tracking-[-0.02em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)] underline decoration-transparent decoration-1 underline-offset-8 transition-colors group-hover:decoration-(--h-red) motion-reduce:transition-none\">DoubleReboot<span class=\"sr-only\"> (se abre en una pestaña nueva)</span></span><span class=\"text-[14px] tabular-nums text-(--h-titanium)\">2013 y 2016</span></span><span class=\"mt-2 block max-w-[52ch] leading-[1.6] text-(--h-titanium)\">El proyecto de Jordi: tutoriales y herramientas de seguridad ofensiva, bajo el paraguas de State X.</span></a></li></ul><p class=\"m-0 mt-2 text-[14px] text-(--h-titanium)\">Fueron proyectos personales de divulgación, no actividad empresarial.</p></div><div class=\"grid content-start gap-px bg-(--h-line) lg:col-span-4\"><div class=\"bg-(--h-ink) py-8 lg:pl-10\"><h3 class=\"m-0 text-[14px] font-normal text-(--h-titanium)\">Investigación</h3><p class=\"m-0 mt-4 max-w-[44ch] leading-[1.6]\">Publicaremos aquí notas técnicas, laboratorios, análisis de vulnerabilidades y recursos para desarrolladores, siempre con fecha y autor.</p></div><div class=\"relative bg-(--h-ink) py-8 lg:pl-10\"><span aria-hidden=\"true\" class=\"absolute left-0 top-0 h-0.5 w-12 bg-(--h-red) lg:left-10\"></span><h3 class=\"m-0 flex items-baseline justify-between gap-3 text-[14px] font-normal\"><span class=\"text-(--h-titanium)\">Hoy</span><span class=\"tabular-nums text-(--h-titanium)\">2026</span></h3><p class=\"m-0 mt-4 max-w-[44ch] leading-[1.6]\">StateX se relanza como consultoría especializada en seguridad de aplicaciones, APIs y exposición externa.</p></div></div></div></div></section><section id=\"preguntas\" aria-labelledby=\"h-preguntas\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)] border-t border-(--h-line)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><div class=\"grid gap-6 lg:grid-cols-12 lg:gap-10\"><p class=\"m-0 flex items-center gap-3 text-[14px] lg:col-span-3 lg:items-start lg:pt-3 text-(--h-titanium)\"><span aria-hidden=\"true\" class=\"h-px w-8 bg-(--h-titanium)/60\"></span>Preguntas frecuentes</p><div class=\"lg:col-span-9\"><h2 id=\"h-preguntas\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 text-[clamp(1.75rem,4.6vw,4.25rem)] max-w-[18ch]\">Antes de escribirnos.</h2></div></div><div class=\"mt-14 border-b border-(--h-line) lg:ml-[calc(25%+0.625rem)]\"><details class=\"group border-t border-(--h-line)\"><summary class=\"flex min-h-18 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[clamp(1.05rem,1.5vw,1.2rem)] font-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) [&amp;::-webkit-details-marker]:hidden\">¿Es legal que auditéis nuestra aplicación?<span aria-hidden=\"true\" class=\"relative size-4 shrink-0\"><span class=\"absolute inset-x-0 top-1/2 h-px bg-(--h-ivory)\"></span><span class=\"absolute inset-y-0 left-1/2 w-px bg-(--h-ivory) transition-transform group-open:scale-y-0 motion-reduce:transition-none\"></span></span></summary><p class=\"m-0 max-w-[62ch] pb-7 leading-[1.6] text-(--h-titanium)\">Sí, con vuestra autorización. Firmamos el alcance y la autorización por escrito antes de empezar. Sin ese documento no hacemos ninguna prueba activa.</p></details><details class=\"group border-t border-(--h-line)\"><summary class=\"flex min-h-18 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[clamp(1.05rem,1.5vw,1.2rem)] font-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) [&amp;::-webkit-details-marker]:hidden\">¿Puede afectar a nuestro servicio en producción?<span aria-hidden=\"true\" class=\"relative size-4 shrink-0\"><span class=\"absolute inset-x-0 top-1/2 h-px bg-(--h-ivory)\"></span><span class=\"absolute inset-y-0 left-1/2 w-px bg-(--h-ivory) transition-transform group-open:scale-y-0 motion-reduce:transition-none\"></span></span></summary><p class=\"m-0 max-w-[62ch] pb-7 leading-[1.6] text-(--h-titanium)\">Acordamos qué se prueba, cuándo y con qué intensidad. Si tenéis un entorno de preproducción, mejor. Lo que pueda afectar al servicio se coordina antes con vuestro equipo.</p></details><details class=\"group border-t border-(--h-line)\"><summary class=\"flex min-h-18 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[clamp(1.05rem,1.5vw,1.2rem)] font-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) [&amp;::-webkit-details-marker]:hidden\">¿En qué se diferencia de un escáner automático?<span aria-hidden=\"true\" class=\"relative size-4 shrink-0\"><span class=\"absolute inset-x-0 top-1/2 h-px bg-(--h-ivory)\"></span><span class=\"absolute inset-y-0 left-1/2 w-px bg-(--h-ivory) transition-transform group-open:scale-y-0 motion-reduce:transition-none\"></span></span></summary><p class=\"m-0 max-w-[62ch] pb-7 leading-[1.6] text-(--h-titanium)\">Un escáner es un punto de partida. Nosotros verificamos a mano cada hallazgo que entra en el informe, descartamos falsos positivos y buscamos lo que un escáner no ve, como los fallos de autorización o de lógica de negocio.</p></details><details class=\"group border-t border-(--h-line)\"><summary class=\"flex min-h-18 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[clamp(1.05rem,1.5vw,1.2rem)] font-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) [&amp;::-webkit-details-marker]:hidden\">¿Cómo se contrata y cuánto cuesta?<span aria-hidden=\"true\" class=\"relative size-4 shrink-0\"><span class=\"absolute inset-x-0 top-1/2 h-px bg-(--h-ivory)\"></span><span class=\"absolute inset-y-0 left-1/2 w-px bg-(--h-ivory) transition-transform group-open:scale-y-0 motion-reduce:transition-none\"></span></span></summary><p class=\"m-0 max-w-[62ch] pb-7 leading-[1.6] text-(--h-titanium)\">La evaluación inicial cuesta 290 € + IVA, precio cerrado. Los demás servicios empiezan en 390 € (exposición externa), 690 € (API), 990 € (web) y 790 € (ingeniería segura), sin IVA. El precio final depende del número de aplicaciones, endpoints, roles y dominios. Tras una primera conversación te enviamos en 48 horas laborables una propuesta cerrada, sin sorpresas después. Lo explicamos en detalle en nuestra guía sobre qué incluye una auditoría de seguridad web.</p></details><details class=\"group border-t border-(--h-line)\"><summary class=\"flex min-h-18 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[clamp(1.05rem,1.5vw,1.2rem)] font-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) [&amp;::-webkit-details-marker]:hidden\">¿Qué necesitáis de nosotros?<span aria-hidden=\"true\" class=\"relative size-4 shrink-0\"><span class=\"absolute inset-x-0 top-1/2 h-px bg-(--h-ivory)\"></span><span class=\"absolute inset-y-0 left-1/2 w-px bg-(--h-ivory) transition-transform group-open:scale-y-0 motion-reduce:transition-none\"></span></span></summary><p class=\"m-0 max-w-[62ch] pb-7 leading-[1.6] text-(--h-titanium)\">Una persona de contacto técnica, el alcance (dominios, aplicaciones o APIs), cuentas de prueba si hacen falta y la autorización firmada. Nunca te pediremos credenciales por el formulario ni por correo sin cifrar.</p></details><details class=\"group border-t border-(--h-line)\"><summary class=\"flex min-h-18 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[clamp(1.05rem,1.5vw,1.2rem)] font-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) [&amp;::-webkit-details-marker]:hidden\">¿Podéis corregir vosotros lo que encontréis?<span aria-hidden=\"true\" class=\"relative size-4 shrink-0\"><span class=\"absolute inset-x-0 top-1/2 h-px bg-(--h-ivory)\"></span><span class=\"absolute inset-y-0 left-1/2 w-px bg-(--h-ivory) transition-transform group-open:scale-y-0 motion-reduce:transition-none\"></span></span></summary><p class=\"m-0 max-w-[62ch] pb-7 leading-[1.6] text-(--h-titanium)\">Sí, si lo contratas. Aplicamos la corrección en vuestro código, configuración o arquitectura, o la dejamos lista para que la aplique vuestro equipo. Se presupuesta aparte, con el alcance claro desde el principio.</p></details><details class=\"group border-t border-(--h-line)\"><summary class=\"flex min-h-18 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[clamp(1.05rem,1.5vw,1.2rem)] font-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) [&amp;::-webkit-details-marker]:hidden\">¿Revisáis las correcciones?<span aria-hidden=\"true\" class=\"relative size-4 shrink-0\"><span class=\"absolute inset-x-0 top-1/2 h-px bg-(--h-ivory)\"></span><span class=\"absolute inset-y-0 left-1/2 w-px bg-(--h-ivory) transition-transform group-open:scale-y-0 motion-reduce:transition-none\"></span></span></summary><p class=\"m-0 max-w-[62ch] pb-7 leading-[1.6] text-(--h-titanium)\">Sí. Durante los 6 meses siguientes al informe, comprobamos que los fallos críticos y altos están corregidos y que la corrección no abre otro problema, y te lo entregamos por escrito.</p></details><details class=\"group border-t border-(--h-line)\"><summary class=\"flex min-h-18 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[clamp(1.05rem,1.5vw,1.2rem)] font-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) [&amp;::-webkit-details-marker]:hidden\">¿Trabajáis con agencias?<span aria-hidden=\"true\" class=\"relative size-4 shrink-0\"><span class=\"absolute inset-x-0 top-1/2 h-px bg-(--h-ivory)\"></span><span class=\"absolute inset-y-0 left-1/2 w-px bg-(--h-ivory) transition-transform group-open:scale-y-0 motion-reduce:transition-none\"></span></span></summary><p class=\"m-0 max-w-[62ch] pb-7 leading-[1.6] text-(--h-titanium)\">Sí. Tenemos un pack de 5 webs por 1.290 € + IVA (240 € cada web adicional), con un informe por web, uno resumen para la agencia y, si lo preferís, con vuestra marca. Para plataformas más complejas, auditoría a medida. Como los activos son del cliente final, la autorización también la firma él.</p></details><details class=\"group border-t border-(--h-line)\"><summary class=\"flex min-h-18 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[clamp(1.05rem,1.5vw,1.2rem)] font-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) [&amp;::-webkit-details-marker]:hidden\">¿Qué pasa si encontráis algo grave durante la auditoría?<span aria-hidden=\"true\" class=\"relative size-4 shrink-0\"><span class=\"absolute inset-x-0 top-1/2 h-px bg-(--h-ivory)\"></span><span class=\"absolute inset-y-0 left-1/2 w-px bg-(--h-ivory) transition-transform group-open:scale-y-0 motion-reduce:transition-none\"></span></span></summary><p class=\"m-0 max-w-[62ch] pb-7 leading-[1.6] text-(--h-titanium)\">Te avisamos el mismo día, sin esperar al informe, para que puedas corregirlo cuanto antes. El protocolo y la persona de contacto se acuerdan antes de empezar.</p></details><details class=\"group border-t border-(--h-line)\"><summary class=\"flex min-h-18 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[clamp(1.05rem,1.5vw,1.2rem)] font-medium focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory) [&amp;::-webkit-details-marker]:hidden\">¿Qué hacéis con la información que encontráis?<span aria-hidden=\"true\" class=\"relative size-4 shrink-0\"><span class=\"absolute inset-x-0 top-1/2 h-px bg-(--h-ivory)\"></span><span class=\"absolute inset-y-0 left-1/2 w-px bg-(--h-ivory) transition-transform group-open:scale-y-0 motion-reduce:transition-none\"></span></span></summary><p class=\"m-0 max-w-[62ch] pb-7 leading-[1.6] text-(--h-titanium)\">La tratamos como confidencial y solo la compartimos con las personas que designéis. Si lo necesitáis, firmamos un acuerdo de confidencialidad antes de empezar.</p></details></div></div></section><section id=\"contacto\" aria-labelledby=\"h-contacto\" class=\"scroll-mt-20 py-[clamp(5.5rem,11vw,10rem)] border-t border-(--h-line)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14\"><h2 id=\"h-contacto\" class=\"[font-family:var(--h-display)] [font-weight:var(--h-display-weight)] [text-transform:var(--h-display-case)] leading-[0.98] tracking-(--h-display-tracking) [font-variation-settings:&#x27;opsz&#x27;_32] text-balance m-0 max-w-[16ch] text-[clamp(2.4rem,6.4vw,6rem)]\">Cuéntanos qué quieres revisar.</h2><span aria-hidden=\"true\" class=\"mt-10 block h-0.5 w-24 bg-(--h-red)\"></span><div class=\"mt-16 grid gap-16 lg:grid-cols-12 lg:gap-10\"><div class=\"lg:col-span-4\"><p class=\"m-0 max-w-[36ch] text-[clamp(1.1rem,1.5vw,1.3rem)] leading-[1.5]\">Te responde una persona del equipo, no un sistema automático.</p><h3 class=\"m-0 mt-12 text-[14px] font-normal text-(--h-titanium)\">Qué pasa después</h3><ol class=\"m-0 mt-5 grid list-none gap-6 p-0\"><li class=\"grid grid-cols-[2rem_1fr] gap-3 border-t border-(--h-line) pt-5\"><span aria-hidden=\"true\" class=\"tabular-nums text-(--h-titanium)\">1</span><div><p class=\"m-0 font-semibold\">Nos escribes</p><p class=\"m-0 mt-1 leading-[1.55] text-(--h-titanium)\">Con lo que quieres proteger y el contexto. Sin datos sensibles.</p></div></li><li class=\"grid grid-cols-[2rem_1fr] gap-3 border-t border-(--h-line) pt-5\"><span aria-hidden=\"true\" class=\"tabular-nums text-(--h-titanium)\">2</span><div><p class=\"m-0 font-semibold\">Hablamos</p><p class=\"m-0 mt-1 leading-[1.55] text-(--h-titanium)\">Una primera conversación para entender la aplicación, los plazos y lo que necesitas.</p></div></li><li class=\"grid grid-cols-[2rem_1fr] gap-3 border-t border-(--h-line) pt-5\"><span aria-hidden=\"true\" class=\"tabular-nums text-(--h-titanium)\">3</span><div><p class=\"m-0 font-semibold\">Recibes una propuesta</p><p class=\"m-0 mt-1 leading-[1.55] text-(--h-titanium)\">En 48 horas laborables: alcance, plazo y precio cerrados antes de empezar cualquier trabajo.</p></div></li></ol></div><div class=\"lg:col-span-7 lg:col-start-6\"><div class=\"border-l-2 border-(--h-titanium) pl-5\"><h3 class=\"m-0 text-[1.35rem] tracking-[-0.01em] [font-family:var(--h-display)] [font-weight:var(--h-title-weight)] [text-transform:var(--h-display-case)]\">Solicitar evaluación</h3><p class=\"m-0 mt-6 max-w-[48ch] text-[17px] leading-[1.55]\">El formulario de contacto todavía no está activo.</p></div></div></div></div></section></main><footer class=\"border-t border-(--h-line)\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-8 lg:px-14 grid gap-10 pb-32 pt-14 sm:grid-cols-2 lg:grid-cols-12\"><div class=\"lg:col-span-4\"><span class=\"inline-flex items-baseline font-semibold uppercase leading-none tracking-[0.32em] text-[17px]\">State<span class=\"relative\">X<span aria-hidden=\"true\" class=\"absolute -bottom-[0.28em] left-0 right-[0.32em] h-[0.09em] min-h-px bg-(--h-red)\"></span></span></span><p class=\"m-0 mt-5 max-w-[32ch] text-(--h-titanium)\">Seguridad de aplicaciones, APIs e infraestructura expuesta, con criterio de ingeniería.</p></div><nav aria-label=\"Servicios\" class=\"lg:col-span-3\"><p class=\"m-0 text-[14px] text-(--h-titanium)\">Servicios</p><ul class=\"m-0 mt-3 grid list-none gap-1 p-0\"><li><a class=\"inline-flex min-h-11 items-center text-(--h-ivory)/80 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/servicios/auditoria-seguridad-web-api\">Auditoría de seguridad web y APIs</a></li><li><a class=\"inline-flex min-h-11 items-center text-(--h-ivory)/80 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/servicios/evaluacion-exposicion-externa\">Evaluación de exposición externa</a></li><li><a class=\"inline-flex min-h-11 items-center text-(--h-ivory)/80 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" href=\"/servicios/ingenieria-software-segura\">Ingeniería de software segura</a></li></ul><p class=\"m-0 mt-6 text-[14px] text-(--h-titanium)\">Guías</p><ul class=\"m-0 mt-3 grid list-none gap-1 p-0\"><li><a class=\"inline-flex min-h-11 items-center text-(--h-ivory)/80 hover:text-(--h-ivory) focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--h-ivory)\" hr