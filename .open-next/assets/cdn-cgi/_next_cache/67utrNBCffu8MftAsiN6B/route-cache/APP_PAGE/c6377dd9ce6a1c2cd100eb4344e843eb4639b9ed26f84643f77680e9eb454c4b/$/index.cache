[{\"@type\":\"Person\",\"name\":\"[retirado]\",\"sameAs\":[\"[retirado]\"]},{\"@type\":\"Person\",\"name\":\"Jordi Sánchez\",\"sameAs\":[\"https://www.linkedin.com/in/jordi-s%C3%A1nchez-carbonell-baa83797/\"]}],\"knowsAbout\":[\"Seguridad de aplicaciones web\",\"Seguridad de APIs\",\"Pentesting web\",\"Superficie de ataque externa\",\"Desarrollo seguro\",\"Corrección de vulnerabilidades\"],\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Servicios\",\"itemListElement\":[{\"@type\":\"Offer\",\"name\":\"Pack para agencias (5 webs)\",\"description\":\"Revisamos la exposición externa y la web pública (sin login) de 5 webs de tus clientes. Un informe por web, uno resumen para la agencia y, si lo prefieres, con tu marca.\",\"priceSpecification\":{\"@type\":\"PriceSpecification\",\"price\":1290,\"priceCurrency\":\"EUR\",\"valueAddedTaxIncluded\":false}},{\"@type\":\"Offer\",\"priceSpecification\":{\"@type\":\"PriceSpecification\",\"minPrice\":690,\"priceCurrency\":\"EUR\",\"valueAddedTaxIncluded\":false},\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Auditoría de seguridad web y APIs\",\"description\":\"Auditoría de seguridad de aplicaciones web y APIs: autenticación, autorización, exposición de datos e integraciones. Hallazgos verificados y plan de corrección.\",\"url\":\"https://statex.jordigw.workers.dev/servicios/auditoria-seguridad-web-api\"}},{\"@type\":\"Offer\",\"priceSpecification\":{\"@type\":\"PriceSpecification\",\"minPrice\":390,\"priceCurrency\":\"EUR\",\"valueAddedTaxIncluded\":false},\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Evaluación de exposición externa\",\"description\":\"Evaluación de la exposición externa de tu empresa: inventario de activos, servicios expuestos, configuraciones débiles y software desactualizado, priorizados por criticidad.\",\"url\":\"https://statex.jordigw.workers.dev/servicios/evaluacion-exposicion-externa\"}},{\"@type\":\"Offer\",\"priceSpecification\":{\"@type\":\"PriceSpecification\",\"minPrice\":790,\"priceCurrency\":\"EUR\",\"valueAddedTaxIncluded\":false},\"itemOffered\":{\"@type\":\"Service\",\"name\":\"Ingeniería de software segura\",\"description\":\"Revisión de arquitectura, autenticación, APIs, CI/CD, dependencias, contenedores y cloud. Diagnóstico técnico, plan de mejoras y acompañamiento a tu equipo de desarrollo.\",\"url\":\"https://statex.jordigw.workers.dev/servicios/ingenieria-software-segura\"}}]}}</script><section id=\"inicio\" aria-labelledby=\"h-hero\" class=\"relative isolate flex min-h-[max(100svh,640px)] flex-col overflow-hidden\"><div class=\"absolute inset-0 -z-10 max-sm:bottom-auto max-sm:h-[56svh] max-sm:[mask-image:linear-gradient(to_bottom,black_65%,transparent)]\" style=\"opacity:1;transform:none\"><svg viewBox=\"0 0 1600 900\" preserveAspectRatio=\"xMidYMid slice\" class=\"h-full w-full\" aria-hidden=\"true\" focusable=\"false\"><defs><radialGradient id=\"h-light\" cx=\"800\" cy=\"210\" r=\"520\" gradientUnits=\"userSpaceOnUse\"><stop offset=\"0\" stop-color=\"#F2F0EA\" stop-opacity=\"0.3\"></stop><stop offset=\"0.45\" stop-color=\"#F2F0EA\" stop-opacity=\"0.07\"></stop><stop offset=\"1\" stop-color=\"#F2F0EA\" stop-opacity=\"0\"></stop></radialGradient><linearGradient id=\"h-fin\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#2C3138\"></stop><stop offset=\"1\" stop-color=\"#181B20\"></stop></linearGradient></defs><rect width=\"1600\" height=\"900\" fill=\"#0B0D10\"></rect><rect width=\"1600\" height=\"900\" fill=\"url(#h-light)\"></rect><g stroke=\"#F2F0EA\" stroke-opacity=\"0.05\"><line x1=\"800\" y1=\"210\" x2=\"-600\" y2=\"900\"></line><line x1=\"800\" y1=\"210\" x2=\"100\" y2=\"900\"></line><line x1=\"800\" y1=\"210\" x2=\"550\" y2=\"900\"></line><line x1=\"800\" y1=\"210\" x2=\"1050\" y2=\"900\"></line><line x1=\"800\" y1=\"210\" x2=\"1500\" y2=\"900\"></line><line x1=\"800\" y1=\"210\" x2=\"2200\" y2=\"900\"></line></g><g style=\"opacity:0\"><rect x=\"616.6666666666667\" y=\"110\" width=\"9.722222222222221\" h